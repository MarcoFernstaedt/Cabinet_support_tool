# Add these to deploy/.env (git ignores it) next to the values from deploy/.env.example. Replace every <placeholder>.

# The one origin the console accepts state-changing requests from: the address in the visitor's browser bar,
# when that differs from https://CONSOLE_SITE (for example a site on another domain that proxies to this front).
CONSOLE_ORIGIN=https://<console-domain>
# The domain Caddyfile.local sends a browser to when it reaches this front directly.
CONSOLE_PUBLIC_URL=https://<console-domain>

# Where Tailscale's connections reach Caddy from: the gateway of FRONTEND_SUBNET. Caddy believes X-Forwarded-For from
# this address only. Tailscale sets that header to the address that connected to it; behind a site on another domain that
# is the site's proxy, so people arriving that way share its addresses (the server's sign-in limit allows for this).
CONSOLE_TRUSTED_PROXIES=172.30.57.1/32

# Names the agent API certificate covers, each one a cabinet can dial. The first is the one shown to operators,
# so put the public address first.
AGENT_API_HOSTNAMES=<public-ip>,<tailnet-host>.ts.net,<tailnet-ip>,localhost

# WARNING: development only. With no code-signing certificate, the agents this image builds pin no publisher and
# trust the release key alone, so whoever holds that key can push code to every cabinet. Keep the release private
# key off this server host. Never use this in production. Rebuild the image after changing it.
#ALLOW_UNSIGNED_DEVELOPMENT_UPGRADES=true
