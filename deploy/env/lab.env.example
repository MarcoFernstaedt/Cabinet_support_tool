# lab environment template: empty values are placeholders, not usable defaults.
# Generated on the server at first run; preserve existing values when moving.
SQL_SA_PASSWORD= # SQL administrator password, long alphanumeric with upper/lower/digits
APP_DB_PASSWORD= # application login password, 24-128 alphanumeric characters
CONSOLE_SECRET_KEY= # 32 random bytes encoded as base64; seals authenticator secrets

# Chosen by the operator
CONSOLE_BASE= # URL path prefix, default /; build-time setting, not a filesystem path
ALLOW_UNSIGNED_DEVELOPMENT_UPGRADES= # false in production; explicit lab-only build switch
ACCEPT_EULA= # Y only after operator accepts SQL Server licence terms
MSSQL_PID= # SQL Server edition, default Express
MSSQL_MEMORY_LIMIT_MB= # SQL Server memory limit in MB, default 2048
CONSOLE_SITE= # console hostname or IP
CONSOLE_TLS= # acme for a DNS name, internal for private console certificates
AGENT_API_HOSTNAMES= # comma-separated names/IPs; exactly the names covered by the agent TLS certificate
AGENT_PUBLIC_HOST= # must be covered by AGENT_API_HOSTNAMES certificate AND reachable by a cabinet; defaults to first name
AGENT_PUBLIC_PORT= # cabinet-dialable agent port; default 8443; does not change published port
AGENT_BIND_IP= # host IP binding for published agent TCP 8443; default 0.0.0.0
CONSOLE_BIND_IP= # host IP binding for console 80/443; local override can replace these ports
CONSOLE_ORIGIN= # exact browser origin including scheme; default https://CONSOLE_SITE
CONSOLE_ALLOW_FROM= # space-separated allowed client CIDRs; default allows everyone
AGENT_API_WORKERS= # agent worker count, default 1
CADDY_IP= # fixed frontend address trusted by server; must belong to FRONTEND_SUBNET
FRONTEND_SUBNET= # Docker frontend CIDR; choose a range without host/VPN conflicts
PUBLIC_IP= # setup.sh first-run input, public IPv4 address; not a Compose port binding
CONSOLE_DOMAIN= # setup.sh first-run input, console DNS name or empty for IP-only
ADMIN_USERNAME= # setup.sh first Admin input; bootstrap only
ADMIN_NAME= # setup.sh first Admin display name; bootstrap only

# Paths: none of the settings above is a filesystem path. Compose fixes PKI, package
# and release directories in named volumes; see PORTABILITY.md. Backup paths are
# script settings, not Compose inputs: BACKUP_DIR, BACKUP_LOG and BACKUP_TARGET.
