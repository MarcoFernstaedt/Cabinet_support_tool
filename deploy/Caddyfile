# The console's HTTPS front. Caddy terminates TLS for the console only.
# The agent API (port 8443) never passes through here: agents authenticate with client certificates,
# so Node terminates their TLS itself and the port is published directly.
#
# CONSOLE_SITE  the console's host name or IP (set by setup.sh in .env)
# CONSOLE_TLS   "acme"     a public domain: a trusted certificate from Let's Encrypt (needs ports 80 and 443 open)
#               "internal" an IP address only: Caddy's own CA; the browser warns until you trust or accept it
# CONSOLE_ALLOW_FROM  the addresses allowed to reach the console, space-separated CIDR ranges (your office, your VPN).
#               The spec keeps the console off the open internet; the default allows everyone, for a first demo only.

{
	# Browsers send no server name (SNI) when they connect to an IP address; answer with the console's certificate.
	default_sni {$CONSOLE_SITE}
}

(tls-acme) {
	# Automatic HTTPS: nothing to configure.
}

(tls-internal) {
	tls internal
}

{$CONSOLE_SITE} {
	import tls-{$CONSOLE_TLS}

	# Only the allowed networks reach the console; everyone else gets 403 and never sees the sign-in page.
	@outside not remote_ip {$CONSOLE_ALLOW_FROM:0.0.0.0/0 ::/0}
	respond @outside "Not available from this network." 403

	# Browsers remember to use HTTPS only (ignored by browsers for an IP address with Caddy's own CA).
	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy server:8080 {
		# The live alert stream (server-sent events) must not be buffered.
		flush_interval -1
		# The server limits sign-in attempts per address, so it must see each browser's own address: exactly one, the one
		# Caddy determined, never a list the browser could have started itself.
		header_up X-Forwarded-For {client_ip}
	}

	log {
		output stdout
		format console
	}
}
