# The console's HTTPS front (LOCAL OVERRIDE — this checkout, not upstream; deploy/compose.yaml mounts this
# file instead of deploy/Caddyfile).
#
# The console is published at https://marcofernstaedt.com -- the domain's ROOT. The site at that domain asks
# this front for everything under /console-proxy and the front strips that marker, so the console answers at
# its own root (/assets/..., /api/...) and the console is built with CONSOLE_BASE=/ to match.
#
# Two things follow, and this file is the whole of them:
#
#   /console-proxy/*  what that rewrite asks for. The path is invisible to visitors; it exists so this front
#                     can tell the site's proxy apart from a browser, because the two want opposite answers
#                     (the proxy wants the console, a browser wants to be sent to the console's public address).
#                     The prefix is stripped before Node sees the request, so Node still serves the console
#                     from its root: /console-proxy/assets/x.js arrives as /assets/x.js.
#   everything else   a browser reaching this front directly (the old tailnet demo link, a bookmark) is sent
#                     to the one public address. A console built under a path cannot be served from this
#                     front's root, and it answers state-changing requests for one pinned origin only.
#
# CONSOLE_SITE  the console's host name or IP (set by setup.sh in .env)
# CONSOLE_TLS   "acme" a public domain: a trusted certificate from Let's Encrypt; "internal" an IP only
# CONSOLE_ALLOW_FROM  the addresses allowed to reach the console, space-separated CIDR ranges

{
	# Browsers send no server name (SNI) when they connect to an IP address; answer with the console's certificate.
	default_sni {$CONSOLE_SITE}
}

(tls-acme) {
	# Automatic HTTPS: nothing to configure.
}

(tls-internal) {
	tls internal
}

{$CONSOLE_SITE} {
	import tls-{$CONSOLE_TLS}

	# Only the allowed networks reach the console; everyone else gets 403 and never sees the sign-in page.
	@outside not remote_ip {$CONSOLE_ALLOW_FROM:0.0.0.0/0 ::/0}
	respond @outside "Not available from this network." 403

	# Browsers remember to use HTTPS only (ignored by browsers for an IP address with Caddy's own CA).
	header Strict-Transport-Security "max-age=31536000"

	# The portfolio site's /console rewrite: strip the marker and hand Node its own paths.
	@proxied path /console-proxy /console-proxy/*
	handle @proxied {
		uri strip_prefix /console-proxy
		reverse_proxy server:8080 {
			# The live alert stream (server-sent events) must not be buffered.
			flush_interval -1
		}
	}

	# Anything else is a browser on this front: send it to the console's public address.
	handle {
		redir * https://marcofernstaedt.com 302
	}

	log {
		output stdout
		format console
	}
}
