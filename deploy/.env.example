# Copy to deploy/.env (setup.sh does this and fills in the values). Never commit deploy/.env.
# Keep it readable by root only: chmod 600 deploy/.env

# --- Names -------------------------------------------------------------------------------------
# The console's address in the browser: a domain (recommended) or the VPS's public IPv4 address.
CONSOLE_SITE=cabinets.example.com
# acme     = a domain whose DNS points at this VPS: a trusted certificate from Let's Encrypt.
# internal = an IP address only: Caddy's own certificate authority; the browser warns once.
CONSOLE_TLS=acme
# Every name or IP the agents use to reach the agent API on port 8443, comma-separated.
# The agent's -PlatformServerHost must be one of these exactly.
AGENT_API_HOSTNAMES=cabinets.example.com,203.0.113.10,localhost

# --- Secrets (generate each with the command shown) --------------------------------------------
# The database owner (migrations only).                    openssl rand -hex 24
POSTGRES_PASSWORD=
# The application's login, cabinet_app_login.              openssl rand -hex 24
APP_DB_PASSWORD=
# Encrypts authenticator secrets. 32 random bytes, base64. openssl rand -base64 32
CONSOLE_SECRET_KEY=

# --- Network (change only if 172.30.57.0/24 is already used on this host) -----------------------
FRONTEND_SUBNET=172.30.57.0/24
CADDY_IP=172.30.57.10
