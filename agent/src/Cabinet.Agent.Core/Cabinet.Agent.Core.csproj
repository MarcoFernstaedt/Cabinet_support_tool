<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything in the agent that does not touch Windows: command validation,
    replay and rate limits, local configuration, the broker pipe protocol and
    the pure helpers the Windows executors use. Portable so its tests run on
    Linux CI.
  -->
  <PropertyGroup>
    <RootNamespace>Cabinet.Agent.Core</RootNamespace>
    <UpgradeTrustDir Condition="'$(UpgradeTrustDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\contracts\trust\upgrade</UpgradeTrustDir>
    <ApprovedListTrustDir Condition="'$(ApprovedListTrustDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\contracts\trust\approved-list</ApprovedListTrustDir>
  </PropertyGroup>
  <!-- Opt-in for a disposable development fleet. The manifest signature, package hash, version and path checks remain mandatory.
       Never pass this property to a production build: it permits unsigned agent executables when no publisher is pinned. -->
  <PropertyGroup Condition="'$(AllowUnsignedDevelopmentUpgrades)' == 'true'">
    <DefineConstants>$(DefineConstants);ALLOW_UNSIGNED_DEVELOPMENT_UPGRADES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- JsonSchema.Net: .NET has no JSON Schema validator, and every input must be
         validated against the shared draft 2020-12 schemas before anything else
         reads it. The same package the contract tests already prove agrees with Ajv. -->
    <PackageReference Include="JsonSchema.Net" Version="9.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cabinet.Agent.Contracts\Cabinet.Agent.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared schemas are compiled into the agent, so a cabinet validates with
         exactly the files the server uses and nothing on disk can change them. -->
    <EmbeddedResource Include="..\..\..\contracts\schemas\**\*.schema.json" LogicalName="schemas/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The trusted publisher list and its pinned roots: compiled in, so only a signed agent upgrade can change them. -->
    <EmbeddedResource Include="..\..\..\contracts\trust\*.json;..\..\..\contracts\trust\*.pem" LogicalName="trust/%(Filename)%(Extension)" />
    <!-- The release signing keys and the agent's own code-signing publisher (docs/spec/07-upgrade-channel.md), compiled in
         the same way. Release builds take them from contracts/trust/upgrade. A test build (Windows CI) may name another folder
         with -p:UpgradeTrustDir=..., holding a throwaway key and certificate made for that run; it is never set for a release. -->
    <EmbeddedResource Include="$(UpgradeTrustDir)\upgrade-keys.json;$(UpgradeTrustDir)\*.pem" LogicalName="upgrade/%(Filename)%(Extension)" />
    <!-- The Admin list-signing keys (docs/spec/09-open-decisions.md "Signing the approved list"), compiled in the same way
         and used to check a signed approved list (ApprovedListTrust). A test build may name another folder with
         -p:ApprovedListTrustDir=...; it is never set for a release. -->
    <EmbeddedResource Include="$(ApprovedListTrustDir)\approved-list-keys.json" LogicalName="approved-list/approved-list-keys.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cabinet.Agent.Core.Tests" />
  </ItemGroup>
  <!--
    F1.R3 (docs/spec/07-upgrade-channel.md "A build that ships to cabinets"): a build for the cabinet release channel
    (-p:CabinetReleaseChannel=production, set by the signing pipeline) must be able to check the code-signing publisher of
    every release it is offered. With no publisher pinned it would refuse every upgrade, and with development upgrades on it
    would accept unsigned programs; either is a build failure, not a warning. Development and test builds leave the property
    unset and are unaffected. A publisher entry always names its pinned root ("rootFile"), so an empty list has none.
  -->
  <Target Name="CheckCabinetReleaseTrust" BeforeTargets="CoreCompile" Condition="'$(CabinetReleaseChannel)' == 'production'">
    <PropertyGroup>
      <_UpgradeKeysText>$([System.IO.File]::ReadAllText('$(UpgradeTrustDir)/upgrade-keys.json'))</_UpgradeKeysText>
    </PropertyGroup>
    <Error Condition="'$(AllowUnsignedDevelopmentUpgrades)' == 'true'"
           Code="CAB0001" Text="A cabinet release build cannot allow unsigned development upgrades (AllowUnsignedDevelopmentUpgrades=true)." />
    <Error Condition="!$(_UpgradeKeysText.Contains('&quot;rootFile&quot;'))"
           Code="CAB0002" Text="A cabinet release build needs a code-signing publisher pinned in $(UpgradeTrustDir)/upgrade-keys.json; with none, the agent would refuse every upgrade." />
  </Target>
</Project>
