<Project Sdk="Microsoft.NET.Sdk">
  <!-- The broker service: LocalSystem, never opens a network connection, serves the locked pipe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Cabinet.Agent.Broker</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- ServiceBase: the standard Windows service host. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cabinet.Agent.Windows\Cabinet.Agent.Windows.csproj" />
  </ItemGroup>
</Project>
