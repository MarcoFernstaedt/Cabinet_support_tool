{
  "name": "@mashura/cabinet-server",
  "private": true,
  "version": "0.1.0",
  "description": "Cabinet diagnostics platform server (Node 22, TypeScript, Fastify): agent API with mutual TLS, enrollment, commands.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-concurrency=2 dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "admin": "node dist/src/cli.js"
  },
  "dependencies": {
    "@mashura/cabinet-contracts": "file:../contracts",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.5",
    "mssql": "12.7.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "22.18.12",
    "playwright": "1.56.1",
    "typescript": "5.9.3"
  },
  "bin": {
    "platform-admin": "dist/src/cli.js"
  }
}
