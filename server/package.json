{
  "name": "@mashura/cabinet-server",
  "private": true,
  "version": "0.1.0",
  "description": "Cabinet diagnostics platform server (Node 22, TypeScript, Fastify): agent API with mutual TLS, enrollment, commands.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "node dist/src/main.js",
    "admin": "node dist/src/cli.js"
  },
  "dependencies": {
    "@mashura/cabinet-contracts": "file:../contracts",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "bin": {
    "platform-admin": "dist/src/cli.js"
  }
}
