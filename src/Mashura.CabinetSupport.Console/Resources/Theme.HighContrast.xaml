<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Under a high-contrast theme every brush becomes a system brush, so the
        palette collapses to the two or three colours the user chose. Status is
        then carried entirely by the label and the glyph.

        That collapse is the point rather than a compromise. If the console were
        ever unreadable here, it would mean some piece of information had been
        resting on colour alone — and this dictionary is the cheapest way to
        find out.
    -->
    <SolidColorBrush x:Key="Severity.Good.Brush"
                     Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Severity.Warning.Brush"
                     Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Severity.Critical.Brush"
                     Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Severity.Neutral.Brush"
                     Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="Severity.Unknown.Brush"
                     Color="{x:Static SystemColors.GrayTextColor}" />

    <SolidColorBrush x:Key="Surface.Brush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Surface.Alt.Brush" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Border.Brush" Color="{x:Static SystemColors.ActiveBorderColor}" />
    <SolidColorBrush x:Key="Text.Brush" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Subtle.Brush" Color="{x:Static SystemColors.GrayTextColor}" />

</ResourceDictionary>
