<Window x:Class="Mashura.CabinetSupport.Console.Dialogs.ActionRequestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Mashura.CabinetSupport.Console.Accessibility"
        Title="{Binding Title}"
        Width="600"
        SizeToContent="Height"
        MaxHeight="820"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface.Brush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="20">

            <TextBlock Text="{Binding ActionName}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1"
                       Foreground="{DynamicResource Text.Brush}" />

            <TextBlock Text="{Binding Description}"
                       Style="{StaticResource ExplanationText}"
                       Margin="0,4,0,12"
                       Foreground="{DynamicResource Text.Subtle.Brush}" />

            <!-- Which machine, spelled out: hostnames repeat across clients. -->
            <Border Style="{StaticResource ExplanationPanel}" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cabinet" Style="{StaticResource FieldLabel}" MinWidth="70" />
                        <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold"
                                   AutomationProperties.Name="Cabinet this action will run on" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Clinic" Style="{StaticResource FieldLabel}" MinWidth="70" />
                        <TextBlock Text="{Binding ClientAndSite}"
                                   AutomationProperties.Name="Client and site" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--
                Parameters, read-only. Nothing here is editable, and there is no
                box for arbitrary text: the values were taken from the row the
                user selected, and the server checks each one against its own
                allow-list before an agent ever sees it.
            -->
            <StackPanel Visibility="{Binding HasParameters, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,12">
                <TextBlock Text="Parameters"
                           Style="{StaticResource SectionHeading}"
                           AutomationProperties.HeadingLevel="Level2" />

                <ItemsControl ItemsSource="{Binding Parameters}"
                              AutomationProperties.Name="Parameters for this action, taken from your selection and not editable here">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding Key}" Style="{StaticResource FieldLabel}" MinWidth="130" />
                                <TextBlock Text="{Binding Value}" FontWeight="SemiBold"
                                           AutomationProperties.Name="{Binding Key}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Consequences, in words, each with a shape beside it. -->
            <Border Style="{StaticResource ExplanationPanel}"
                    Margin="0,0,0,12"
                    Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Before you continue"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               AutomationProperties.HeadingLevel="Level2"
                               Foreground="{DynamicResource Text.Brush}" />

                    <ItemsControl ItemsSource="{Binding Warnings}"
                                  AutomationProperties.Name="Consequences of this action">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="▲"
                                               FontFamily="Segoe UI Symbol"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Top"
                                               AutomationProperties.AccessibilityView="Raw"
                                               Foreground="{DynamicResource Severity.Warning.Brush}" />
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               MaxWidth="480"
                                               Foreground="{DynamicResource Text.Brush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===================== Reason and ticket ===================== -->
            <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ReasonBox"
                     Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="64"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="0"
                     Margin="0,0,0,10"
                     AutomationProperties.Name="Reason for this action"
                     AutomationProperties.HelpText="Required. Goes into the audit trail and is what a compliance reviewer will read." />

            <TextBlock Text="Ticket reference" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding TicketReference, UpdateSourceTrigger=PropertyChanged}"
                     TabIndex="1"
                     Margin="0,0,0,10"
                     AutomationProperties.Name="Ticket reference"
                     AutomationProperties.HelpText="Required. The ticket this work belongs to." />

            <!-- ===================== Supervisor override ===================== -->
            <StackPanel Visibility="{Binding CanOfferOverride, Converter={StaticResource BoolToVisibility}}"
                        Margin="0,0,0,10">
                <CheckBox IsChecked="{Binding OverrideSafetyChecks}"
                          TabIndex="2"
                          Content="Override the safety checks (Supervisor only)"
                          AutomationProperties.Name="Override the safety checks. Supervisor only. Runs a disruptive action despite a logged-on user or outside the maintenance window."
                          Foreground="{DynamicResource Severity.Critical.Brush}" />

                <StackPanel Margin="0,8,0,0"
                            Visibility="{Binding OverrideReasonRequired, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="Reason for the override" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding OverrideReason, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="48"
                             TabIndex="3"
                             AutomationProperties.Name="Reason for overriding the safety checks"
                             AutomationProperties.HelpText="Required when overriding. Recorded alongside the override itself." />
                </StackPanel>
            </StackPanel>

            <!-- A disabled confirm always says why. -->
            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="What is still needed"
                           Foreground="{DynamicResource Severity.Warning.Brush}" />
            </Border>

            <!--
                Cancel first in tab order and holding initial focus. Confirm is
                deliberately not IsDefault: a dialog that turns an in-flight
                Return keystroke into consent for a reboot has not obtained
                consent.
            -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        IsCancel="True"
                        TabIndex="10"
                        MinWidth="110"
                        a11y:FocusBehaviour.FocusOnLoad="True"
                        AutomationProperties.Name="Cancel. Nothing will be submitted." />

                <Button Content="Submit request"
                        Click="OnSubmit"
                        IsEnabled="{Binding CanSubmit}"
                        TabIndex="11"
                        MinWidth="140"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Submit this action request" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
