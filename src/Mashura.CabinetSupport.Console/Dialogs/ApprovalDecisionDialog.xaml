<Window x:Class="Mashura.CabinetSupport.Console.Dialogs.ApprovalDecisionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:Mashura.CabinetSupport.Console.Accessibility"
        Title="{Binding Title}"
        Width="600"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Surface.Brush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="20">

            <TextBlock Text="{Binding Title}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       AutomationProperties.HeadingLevel="Level1"
                       Foreground="{DynamicResource Text.Brush}" />

            <Border Style="{StaticResource ExplanationPanel}" Margin="0,10,0,12">
                <StackPanel DataContext="{Binding Row}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Action" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActionName}"
                                   FontWeight="SemiBold" AutomationProperties.Name="Action" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Cabinet" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hostname}"
                                   AutomationProperties.Name="Cabinet" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Parameters" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Parameters}"
                                   TextWrapping="Wrap" AutomationProperties.Name="Parameters" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Requested by" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RequestedBy}"
                                   AutomationProperties.Name="Requested by" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Their reason" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Reason}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Reason given by the requester" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Ticket" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Ticket}"
                                   AutomationProperties.Name="Ticket reference" />
                    </Grid>

                    <TextBlock Text="{Binding OverrideNote}"
                               Style="{StaticResource ExplanationText}"
                               Margin="0,8,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Severity.Warning.Brush}"
                               AutomationProperties.Name="Safety override on this request"
                               Visibility="{Binding OverrideNote, Converter={StaticResource StringToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Consequence}"
                       Style="{StaticResource ExplanationText}"
                       Margin="0,0,0,12"
                       AutomationProperties.Name="What happens next" />

            <TextBlock Text="{Binding NoteLabel}" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="64"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="0"
                     Margin="0,0,0,10"
                     AutomationProperties.Name="{Binding NoteLabel}"
                     AutomationProperties.HelpText="Recorded in the audit trail beside your decision." />

            <TextBlock Text="Ticket reference (optional)" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding TicketReference, UpdateSourceTrigger=PropertyChanged}"
                     TabIndex="1"
                     Margin="0,0,0,10"
                     AutomationProperties.Name="Ticket reference for your decision"
                     AutomationProperties.HelpText="Leave blank to keep the requester's ticket." />

            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ValidationMessage}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="What is still needed"
                           Foreground="{DynamicResource Severity.Warning.Brush}" />
            </Border>

            <!-- Cancel holds initial focus, and Confirm is not the default button. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel"
                        IsCancel="True"
                        TabIndex="10"
                        MinWidth="110"
                        a11y:FocusBehaviour.FocusOnLoad="True"
                        AutomationProperties.Name="Cancel. No decision will be recorded." />

                <Button Content="{Binding ConfirmLabel}"
                        Click="OnConfirm"
                        IsEnabled="{Binding CanConfirm}"
                        TabIndex="11"
                        MinWidth="140"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="{Binding Title}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
