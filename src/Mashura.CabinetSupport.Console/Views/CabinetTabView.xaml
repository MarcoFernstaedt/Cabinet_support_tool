<UserControl x:Class="Mashura.CabinetSupport.Console.Views.CabinetTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface.Brush}">

    <!--
        An empty state with reasons, not a placeholder with invented numbers.

        Everything visible here is text. There is no sensor reading, no drawer
        state and no gauge sitting at zero, because none of those are collected
        yet and a plausible-looking value would be read as a real one the first
        time somebody screenshots this tab.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="16" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Title}"
                       Style="{StaticResource SectionHeading}"
                       FontSize="17"
                       AutomationProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource ExplanationPanel}"
                    AutomationProperties.Name="{Binding AccessibleSummary}">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyStateHeading}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Text.Brush}" />

                    <TextBlock Text="{Binding EmptyStateDetail}"
                               Style="{StaticResource ExplanationText}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Why this tab is here"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"
                               AutomationProperties.HeadingLevel="Level3"
                               Foreground="{DynamicResource Text.Brush}" />

                    <TextBlock Text="{Binding WhyThisTabExists}"
                               Style="{StaticResource ExplanationText}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="No hardware controls"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"
                               AutomationProperties.HeadingLevel="Level3"
                               Foreground="{DynamicResource Text.Brush}" />

                    <TextBlock Text="{Binding NoActuationNote}"
                               Style="{StaticResource ExplanationText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
