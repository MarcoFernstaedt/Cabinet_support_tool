{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SupportDatabase": "Data Source=cabinet-support.db"
  },

  "_secrets": [
    "Jwt:SigningKey, AgentAuth:SharedSecret and Seed:SupervisorInitialPassword are intentionally",
    "absent from this file. Supply them per deployment through environment variables or the",
    "platform's secret store, for example Jwt__SigningKey. The server refuses to start without",
    "them rather than falling back to anything guessable."
  ],

  "Jwt": {
    "Issuer": "mashura-cabinet-support",
    "Audience": "mashura-cabinet-support-console",
    "TokenLifetimeMinutes": 60
  },

  "AgentAuth": {
    "HeaderName": "X-Mashura-Agent-Key",
    "MachineIdHeaderName": "X-Mashura-Machine-Id"
  },

  "Password": {
    "Iterations": 210000,
    "SaltBytes": 16,
    "HashBytes": 32,
    "MinimumLength": 12,
    "MaximumLength": 256,
    "RequireMixedCharacterClasses": true
  },

  "LoginSecurity": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RateLimitPermitPerWindow": 10,
    "RateLimitWindowSeconds": 60
  },

  "AgentIngest": {
    "CheckInIntervalSeconds": 300,
    "RegistrationRetrySeconds": 900,
    "RegisterPermitPerWindow": 5,
    "RegisterWindowSeconds": 300,
    "CheckInPermitPerWindow": 20,
    "CheckInWindowSeconds": 60,
    "OfflineAfterMinutes": 20,
    "MaxClockSkewMinutes": 10
  },

  "Actions": {
    "ApprovalExpiryMinutes": 30,
    "UnapprovedActionExpiryMinutes": 30,
    "ExpirySweepIntervalSeconds": 60,
    "MaintenanceWindowStartHourUtc": 2,
    "MaintenanceWindowEndHourUtc": 6
  },

  "Retention": {
    "Enabled": true,
    "CheckInRetentionDays": 30,
    "SmartFullResolutionDays": 90,
    "SmartAggregateRetentionDays": 730,
    "SweepIntervalHours": 6,
    "BatchSize": 1000
  },

  "Seed": {
    "SupervisorUsername": "supervisor",
    "SupervisorDisplayName": "Initial Supervisor"
  },

  "QueryLimits": {
    "MaxHistoryRangeDays": 90,
    "DefaultHistoryRangeDays": 7
  },

  "ServiceAllowList": {
    "Services": [
      "MashuraCabinetAgent",
      "MashuraCabinetService",
      "MashuraDispenseController",
      "MashuraSyncService",
      "Spooler",
      "W32Time",
      "Dnscache",
      "wuauserv",
      "BITS"
    ]
  }
}
