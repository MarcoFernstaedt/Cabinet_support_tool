{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "//": "All log output goes to standard error so that the JSON printed by --collect-once is the only thing on standard output and can be redirected to a file or piped into a parser.",
          "standardErrorFromLevel": "Verbose"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 16777216,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Agent": {
    "ServerBaseUrl": "https://localhost:7001",
    "CheckInIntervalSeconds": 300,
    "CheckInJitterPercent": 5,
    "StateDirectory": "state",
    "LogDirectory": "logs",
    "Buffer": {
      "Directory": "buffer",
      "MaxFileCount": 500,
      "MaxTotalMegabytes": 64
    },
    "Backoff": {
      "InitialSeconds": 30,
      "MaximumSeconds": 1800,
      "Multiplier": 2.0
    },
    "Collection": {
      "EventLogWindowHours": 24,
      "EventLogMaxEntries": 300,
      "MaxProcesses": 200,
      "MaxInstalledSoftware": 1000,
      "WindowsUpdateTimeoutSeconds": 120,
      "ServerReachabilityTimeoutSeconds": 5,
      "CpuSampleIntervalMilliseconds": 500
    },
    "Actions": {
      "DefaultTimeoutSeconds": 120,
      "TimeoutSecondsByAction": {
        "ScanForUpdates": 300,
        "CollectDiagnosticBundle": 300,
        "RestartService": 180,
        "RebootMachine": 60
      },
      "ServiceAllowList": [
        "Spooler",
        "Dnscache",
        "wuauserv",
        "BITS",
        "W32Time"
      ],
      "RebootDelaySeconds": 60,
      "DiagnosticBundleDirectory": "bundles",
      "MaxUpdateScheduleDays": 30
    }
  }
}
