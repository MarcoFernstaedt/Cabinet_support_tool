<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Every ViewModel, the API client and all presentation logic live here, in a
    plain library with no WPF reference at all.

    That is not tidiness for its own sake. It is what makes "no business logic
    in code-behind" a property of the build rather than a rule people remember:
    a ViewModel physically cannot reach for a Window, a Dispatcher or a
    MessageBox, because none of those types are on its compile path. It also
    means the whole logic layer is unit-testable on any platform, which is how
    the unhappy paths in this client get covered at all.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mashura.CabinetSupport.Contracts\Mashura.CabinetSupport.Contracts.csproj" />
  </ItemGroup>

</Project>
