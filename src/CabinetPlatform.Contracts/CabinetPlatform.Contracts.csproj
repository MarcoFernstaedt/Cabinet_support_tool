<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CabinetPlatform.Contracts</RootNamespace>
    <AssemblyName>CabinetPlatform.Contracts</AssemblyName>
    <!-- Contracts are the public surface between three executables: every
         public member must carry documentation, enforced as a build error. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
