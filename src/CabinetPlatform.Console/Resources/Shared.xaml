<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CabinetPlatform.Console.Converters"
                    xmlns:vm="clr-namespace:CabinetPlatform.Console.Core.Presentation;assembly=CabinetPlatform.Console.Core">

    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    <conv:StatusToTextConverter x:Key="StatusToText" />

    <!-- Only the focus adorner is templated. Native controls and UIA peers stay intact.
         Two strokes remain visible on both the navy canvas and native light chrome. -->
    <Style x:Key="KeyboardFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border BorderBrush="{DynamicResource Surface.Brush}" BorderThickness="1" Margin="-3" IsHitTestVisible="False">
                        <Border BorderBrush="{DynamicResource Focus.Brush}" BorderThickness="2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Every column header gets its text as its automation name. Done once here
        rather than column by column, because the column the one person forgets
        is the column a screen reader announces as "column 7".
    -->
    <Style x:Key="AccessibleColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="AutomationProperties.Name"
                Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!--
        Rows carry a whole-row sentence as their automation name, so arrowing
        down a grid reads the state of a cabinet rather than making the user
        traverse nine columns to assemble it themselves.
    -->
    <Style x:Key="AccessibleRow" TargetType="DataGridRow">
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Style.Triggers>
            <!-- An outline, not only a fill color, identifies selected rows. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Focus.Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Style.Triggers>
            <!-- Keep status-template text readable too; native highlight fills
                 would otherwise sit behind locally colored status text. -->
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Surface.Alt.Brush}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Surface.Alt.Brush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Focus.Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AccessibleDataGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Border.Brush}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource AccessibleColumnHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource AccessibleRow}" />
        <!-- Keyboard users must be able to reach and read a cell's text. -->
        <Setter Property="IsTabStop" Value="True" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Subtle.Brush}" />
        <Setter Property="Margin" Value="0,0,8,2" />
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        The panel that explains why a section has nothing in it. Bordered and
        worded rather than blank: a blank panel is indistinguishable from a
        machine with nothing wrong with it.
    -->
    <Style x:Key="ExplanationPanel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.Alt.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <Style x:Key="ExplanationText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
    </Style>

    <Style TargetType="Button">
        <!-- Preserve paired system colors for native hover/pressed chrome. -->
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Brush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style TargetType="ComboBox">
        <!-- Preserve paired system colors for native hover/pressed chrome. -->
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- Native navigation/selection templates remain in charge of their chrome. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="Background" Value="{DynamicResource Surface.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text.Brush}" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Text.Brush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
    </Style>

    <!--
        Severity colour, applied through triggers rather than a value converter.

        A converter would resolve the brush once when the binding is first
        evaluated and never hear about the palette being swapped, so turning
        high contrast on mid-session would leave every status glyph painted in
        the old colours. DynamicResource inside a trigger setter re-resolves.
    -->
    <Style x:Key="SeverityGlyph" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Severity.Neutral.Brush}" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="FontFamily" Value="Segoe UI Symbol" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Good">
                <Setter Property="Foreground" Value="{DynamicResource Severity.Good.Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter Property="Foreground" Value="{DynamicResource Severity.Warning.Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                <Setter Property="Foreground" Value="{DynamicResource Severity.Critical.Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Unknown">
                <Setter Property="Foreground" Value="{DynamicResource Severity.Unknown.Brush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Status: glyph and word, always together. This template is the single
        place the pairing is enforced, so a view cannot show one without the
        other by omission.

        The StackPanel carries the accessible name and both children are marked
        Raw, so a screen reader reads "Healthy" once rather than reading the
        glyph, then the word, then the pair again.
    -->
    <DataTemplate x:Key="StatusTemplate" DataType="{x:Type vm:StatusPresentation}">
        <StackPanel Orientation="Horizontal"
                    AutomationProperties.Name="{Binding AccessibleText}">
            <TextBlock Text="{Binding Glyph}"
                       Style="{StaticResource SeverityGlyph}"
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <TextBlock Text="{Binding Label}"
                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                       Foreground="{DynamicResource Text.Brush}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
