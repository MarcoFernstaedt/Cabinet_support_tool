<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Navy surfaces, restrained cyan focus. Status always also has text. -->
    <SolidColorBrush x:Key="Severity.Good.Brush" Color="#78DCAA" />
    <SolidColorBrush x:Key="Severity.Warning.Brush" Color="#FFD080" />
    <SolidColorBrush x:Key="Severity.Critical.Brush" Color="#FF9CA8" />
    <SolidColorBrush x:Key="Severity.Neutral.Brush" Color="#DDE7F2" />
    <SolidColorBrush x:Key="Severity.Unknown.Brush" Color="#B5C3D5" />
    <SolidColorBrush x:Key="Surface.Brush" Color="#101822" />
    <SolidColorBrush x:Key="Surface.Alt.Brush" Color="#1B2838" />
    <SolidColorBrush x:Key="Border.Brush" Color="#71869E" />
    <SolidColorBrush x:Key="Text.Brush" Color="#E6EDF5" />
    <SolidColorBrush x:Key="Text.Subtle.Brush" Color="#B5C3D5" />
    <SolidColorBrush x:Key="Focus.Brush" Color="#65DAF2" />
    <SolidColorBrush x:Key="Badge.Background.Brush" Color="#FFD080" />
    <SolidColorBrush x:Key="Badge.Text.Brush" Color="#101822" />
</ResourceDictionary>
