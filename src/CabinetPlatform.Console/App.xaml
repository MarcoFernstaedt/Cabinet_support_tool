<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CabinetPlatform.Console.Converters"
             x:Class="CabinetPlatform.Console.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Index 0 is the palette and is swapped at runtime when the
                    user turns high contrast on or off. Shared.xaml refers to
                    its brushes with DynamicResource so the swap reaches
                    everything already on screen.
                -->
                <ResourceDictionary Source="pack://application:,,,/CabinetPlatform.Console;component/Resources/Theme.Default.xaml" />
                <ResourceDictionary Source="pack://application:,,,/CabinetPlatform.Console;component/Resources/Shared.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:SupportTimeConverter x:Key="SupportTime" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
