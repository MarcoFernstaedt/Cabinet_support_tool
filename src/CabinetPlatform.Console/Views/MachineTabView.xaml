<UserControl x:Class="CabinetPlatform.Console.Views.MachineTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface.Brush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/CabinetPlatform.Console;component/Views/Sections/SectionResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>

        <!-- ========================= Header ========================= -->
        <StackPanel DockPanel.Dock="Top" Margin="8,8,8,0">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh this cabinet's machine data" />

                <!--
                    The persistent identification. It sits above the
                    ScrollViewer rather than inside it, so it stays on screen
                    while the sections below scroll: a rep forty rows into an
                    event log has had the cabinet's name off screen for some
                    time, and the next thing they do will be on whichever
                    cabinet they believe they are looking at.

                    Client and site lead, because the cabinet name alone
                    identifies nothing — hostnames repeat freely across three
                    and a half thousand client organisations.
                -->
                <StackPanel>
                    <TextBlock Text="{Binding HeaderClientAndSite}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.Subtle.Brush}"
                               AutomationProperties.Name="Client and site" />

                    <TextBlock Style="{StaticResource SectionHeading}"
                               FontSize="17"
                               AutomationProperties.HeadingLevel="Level2"
                               AutomationProperties.Name="{Binding HeaderAccessibleSummary}">
                        <Run Text="{Binding HeaderCabinetName, Mode=OneWay}" />
                        <Run Text=" — " />
                        <Run Text="{Binding HeaderRoleLabel, Mode=OneWay}" FontSize="13" />
                    </TextBlock>

                    <TextBlock Text="{Binding HeaderPath}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource Text.Subtle.Brush}"
                               AutomationProperties.Name="Full path" />
                </StackPanel>
            </DockPanel>

            <ProgressBar IsIndeterminate="True"
                         Height="4"
                         Margin="0,6,0,0"
                         AutomationProperties.Name="Loading machine data"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Machine tab problem"
                           Foreground="{DynamicResource Severity.Critical.Brush}" />
            </Border>

            <!--
                Says up front which sections arrive on request rather than with
                routine telemetry, so an empty panel is never something a user
                discovers only by opening it and guessing.
            -->
            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding OnDemandSectionNote, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding OnDemandSectionNote}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.Name="Coverage note" />
            </Border>
        </StackPanel>

        <!-- ======================== Sections ======================== -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="8"
                      Focusable="False">
            <StackPanel>

                <!-- Overview -->
                <Expander IsExpanded="{Binding Overview.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding Overview.Title}"
                          AutomationProperties.HelpText="{Binding Overview.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Overview.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding Overview}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Hostname" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hostname}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Hostname" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Machine identifier" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineId}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Machine identifier" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Client" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Client}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Client" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Site" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Site}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Site" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Department" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Department}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Department" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Operating system" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="5" Grid.Column="1">
                                <TextBlock Text="{Binding OsVersion}" Style="{StaticResource FieldValue}"
                                           AutomationProperties.Name="Operating system version" />
                                <TextBlock Text="{Binding OsBuildNote}"
                                           Style="{StaticResource ExplanationText}"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource Text.Subtle.Brush}" />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Uptime" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Uptime}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Uptime" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Last check-in" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding LastCheckInAge}" Style="{StaticResource FieldValue}"
                                           AutomationProperties.Name="Time since last check-in" />
                                <TextBlock Text=" — " Foreground="{DynamicResource Text.Subtle.Brush}" />
                                <TextBlock Text="{Binding LastCheckInExact}"
                                           Foreground="{DynamicResource Text.Subtle.Brush}"
                                           AutomationProperties.Name="Exact time of last check-in" />
                            </StackPanel>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Agent version" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding AgentVersion}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Agent version" />

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Health" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="9" Grid.Column="1" Content="{Binding Health}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Logged on" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="10" Grid.Column="1" Content="{Binding LoggedOn}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="11" Grid.Column="0" Text="Cabinet record" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="11" Grid.Column="1" Content="{Binding Active}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />
                        </Grid>
                    </StackPanel>
                </Expander>

                <!-- Performance -->
                <Expander IsExpanded="{Binding Performance.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding Performance.Title}"
                          AutomationProperties.HelpText="{Binding Performance.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Performance.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding Performance}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Processor" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding CpuPercent}" Style="{StaticResource FieldValue}"
                                           Margin="0,0,10,0"
                                           AutomationProperties.Name="Processor utilisation" />
                                <ContentPresenter Content="{Binding CpuState}"
                                                  ContentTemplate="{StaticResource StatusTemplate}" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Memory used" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding RamUsedPercent}" Style="{StaticResource FieldValue}"
                                           Margin="0,0,10,0"
                                           AutomationProperties.Name="Memory utilisation" />
                                <ContentPresenter Content="{Binding RamState}"
                                                  ContentTemplate="{StaticResource StatusTemplate}" />
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding RamUsed}" Style="{StaticResource FieldValue}"
                                           AutomationProperties.Name="Memory in use" />
                                <TextBlock Text=" of " Foreground="{DynamicResource Text.Subtle.Brush}" />
                                <TextBlock Text="{Binding RamTotal}" Style="{StaticResource FieldValue}"
                                           AutomationProperties.Name="Total memory" />
                            </StackPanel>
                        </Grid>

                        <!-- The process list, and why there is not one. -->
                        <ContentControl Content="{Binding ProcessListAvailability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Margin="0,8,0,0" />
                    </StackPanel>
                </Expander>

                <!-- Services -->
                <Expander IsExpanded="{Binding Services.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding Services.Title}"
                          AutomationProperties.HelpText="{Binding Services.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Services.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding Services}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     MinWidth="220"
                                     AutomationProperties.Name="Filter services by name"
                                     Margin="0,0,12,0" />

                            <CheckBox IsChecked="{Binding ShowOnlyAutoStartStopped}"
                                      VerticalAlignment="Center"
                                      Content="Auto-start but stopped"
                                      AutomationProperties.Name="Show only services set to start automatically that are currently stopped"
                                      AutomationProperties.HelpText="The usual cause of a cabinet that is up but not dispensing." />
                        </StackPanel>

                        <TextBlock Text="{Binding FilterSummary}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Service filter result"
                                   Foreground="{DynamicResource Text.Subtle.Brush}"
                                   Margin="0,0,0,6" />

                        <DataGrid ItemsSource="{Binding Services}"
                                  SelectedItem="{Binding SelectedService}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  MaxHeight="320"
                                  AutomationProperties.Name="Windows services. Select a row, then choose an action below.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Display name" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="Service name" Binding="{Binding ServiceName}" Width="Auto" />
                                <DataGridTemplateColumn Header="State" Width="Auto" SortMemberPath="State.Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding State}"
                                                              ContentTemplate="{StaticResource StatusTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Start mode" Binding="{Binding StartMode}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--
                            The start type the set-start-type action would
                            apply. Boot and System are absent: they are driver
                            load orders, and setting an ordinary service to one
                            does not make it start earlier, it makes the machine
                            fail to boot.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Set start type to"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                            <ComboBox ItemsSource="{Binding StartTypeChoices}"
                                      SelectedItem="{Binding SelectedStartType}"
                                      MinWidth="180"
                                      AutomationProperties.Name="Start type to apply to the selected service" />
                        </StackPanel>

                        <TextBlock Text="{Binding StartTypeWarning}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Start type warning"
                                   Foreground="{DynamicResource Severity.Warning.Brush}"
                                   Visibility="{Binding StartTypeWarning, Converter={StaticResource StringToVisibility}}" />

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SectionActionsTemplate}" />
                    </StackPanel>
                </Expander>

                <!--
                    Processes. Task Manager equivalence, which is most of what a
                    remote desktop session was being opened for. Ending a
                    process is offered from the selected row and never from a
                    typed name: the server keeps an allow-list and so does the
                    agent, and a free-text box would only be a way of asking
                    both of them to say no.
                -->
                <Expander IsExpanded="{Binding Processes.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding Processes.Title}"
                          AutomationProperties.HelpText="{Binding Processes.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Processes.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding Processes}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="220"
                                 HorizontalAlignment="Left"
                                 Margin="0,0,0,6"
                                 AutomationProperties.Name="Filter processes by name or process id" />

                        <TextBlock Text="{Binding FilterSummary}"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Process list result"
                                   Foreground="{DynamicResource Text.Subtle.Brush}"
                                   Margin="0,0,0,6" />

                        <DataGrid ItemsSource="{Binding Processes}"
                                  SelectedItem="{Binding SelectedProcess}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  MaxHeight="320"
                                  AutomationProperties.Name="Running processes. Select a row, then choose an action below.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <!--
                                    The id is shown beside the name because the
                                    pair is the identification. Windows reuses
                                    ids within minutes, which is why an action
                                    on this row carries both and the agent
                                    refuses them if the machine disagrees.
                                -->
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="Auto" />
                                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="Auto" />
                                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="Auto" />
                                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="Auto" />
                                <DataGridTextColumn Header="Handles" Binding="{Binding Handles}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SectionActionsTemplate}" />
                    </StackPanel>
                </Expander>

                <!-- Disk -->
                <Expander IsExpanded="{Binding Disk.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding Disk.Title}"
                          AutomationProperties.HelpText="{Binding Disk.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Disk.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding Disk}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="Volumes" Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level4" />

                        <ContentControl Content="{Binding VolumesAvailability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding VolumesAvailability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <DataGrid ItemsSource="{Binding Volumes}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  MaxHeight="180"
                                  Margin="0,0,0,12"
                                  AutomationProperties.Name="Disk volumes">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Volume" Binding="{Binding VolumeId}" Width="Auto" />
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="*" />
                                <DataGridTextColumn Header="File system" Binding="{Binding FileSystem}" Width="Auto" />
                                <DataGridTextColumn Header="Free" Binding="{Binding FreeBytes}"
                                                    SortMemberPath="Snapshot.FreeBytes" Width="Auto" />
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalBytes}"
                                                    SortMemberPath="Snapshot.TotalBytes" Width="Auto" />
                                <DataGridTextColumn Header="Free percent" Binding="{Binding FreePercent}"
                                                    SortMemberPath="Snapshot.FreePercent" Width="Auto" />
                                <DataGridTemplateColumn Header="Free space" Width="Auto" SortMemberPath="Space.Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Space}"
                                                              ContentTemplate="{StaticResource StatusTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Drives and SMART counters" Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level4" />

                        <ContentControl Content="{Binding SmartAvailability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding SmartAvailability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <DataGrid ItemsSource="{Binding Drives}"
                                  SelectedItem="{Binding SelectedDrive}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  MaxHeight="200"
                                  Margin="0,0,0,12"
                                  AutomationProperties.Name="Drives. Select one to see its trend below.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Serial" Binding="{Binding DriveSerial}" Width="Auto" />
                                <DataGridTextColumn Header="Model" Binding="{Binding DriveModel}" Width="*" />
                                <DataGridTemplateColumn Header="Health" Width="Auto" SortMemberPath="Health.Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Health}"
                                                              ContentTemplate="{StaticResource StatusTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Reallocated sectors" Binding="{Binding ReallocatedSectors}" Width="Auto" />
                                <DataGridTextColumn Header="Pending sectors" Binding="{Binding PendingSectors}" Width="Auto" />
                                <DataGridTextColumn Header="Uncorrectable errors" Binding="{Binding UncorrectableErrors}" Width="Auto" />
                                <DataGridTextColumn Header="Wear" Binding="{Binding Wear}" Width="Auto" />
                                <DataGridTextColumn Header="Read errors" Binding="{Binding ReadErrorsTotal}" Width="Auto" />
                                <DataGridTextColumn Header="Write errors" Binding="{Binding WriteErrorsTotal}" Width="Auto" />
                                <DataGridTextColumn Header="Power-on hours" Binding="{Binding PowerOnHours}" Width="Auto" />
                                <DataGridTextColumn Header="Temperature" Binding="{Binding Temperature}" Width="Auto" />
                                <DataGridTextColumn Header="Highest temperature" Binding="{Binding TemperatureMax}" Width="Auto" />
                                <DataGridTextColumn Header="Predicted failure" Binding="{Binding PredictedFailure}" Width="Auto" />
                                <!--
                                    Shown rather than hidden: a counter decoded out of a
                                    vendor-specific byte array and a documented reliability
                                    counter deserve different amounts of confidence, and only
                                    the row itself knows which it is.
                                -->
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" />
                                <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="Auto" />
                                <DataGridTextColumn Header="Sampled" Binding="{Binding Timestamp}"
                                                    SortMemberPath="TimestampUtc" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Trend window" Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding HistoryDayChoices}"
                                      SelectedItem="{Binding HistoryDays}"
                                      MinWidth="90"
                                      HorizontalAlignment="Left"
                                      AutomationProperties.Name="SMART trend window in days"
                                      AutomationProperties.HelpText="How many days of SMART readings to trend. The server refuses windows wider than 90 days." />
                        </DockPanel>

                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                                     AutomationProperties.Name="Loading SMART trend"
                                     Visibility="{Binding IsHistoryLoading, Converter={StaticResource BoolToVisibility}}" />

                        <ContentControl Content="{Binding HistoryAvailability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding HistoryAvailability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            The trend as a table. There is no chart-only view
                            anywhere in this console: a sparkline is a picture,
                            and a picture is not data to a screen reader or to
                            anyone who needs to quote a figure into a ticket.
                            Each series states its direction in words as well.
                        -->
                        <ItemsControl ItemsSource="{Binding TrendSeries}"
                                      AutomationProperties.Name="SMART counter trends">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border.Brush}"
                                            BorderThickness="1"
                                            Padding="10"
                                            Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       AutomationProperties.HeadingLevel="Level5" />
                                            <TextBlock Text="{Binding Direction}"
                                                       Margin="0,2,0,6"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="Trend direction"
                                                       Foreground="{DynamicResource Text.Subtle.Brush}" />

                                            <DataGrid ItemsSource="{Binding Points}"
                                                      Style="{StaticResource AccessibleDataGrid}"
                                                      MaxHeight="200"
                                                      AutomationProperties.Name="{Binding AccessibleSummary}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Sampled" Binding="{Binding Timestamp}"
                                                                        SortMemberPath="TimestampUtc" Width="*" />
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Display}" Width="Auto" />
                                                    <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>

                <!-- Windows Update -->
                <Expander IsExpanded="{Binding WindowsUpdate.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding WindowsUpdate.Title}"
                          AutomationProperties.HelpText="{Binding WindowsUpdate.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding WindowsUpdate.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding WindowsUpdate}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Pending" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding PendingCount}" Style="{StaticResource FieldValue}"
                                       Margin="0,0,16,0"
                                       AutomationProperties.Name="Pending update count" />
                            <ContentPresenter Content="{Binding SecurityPending}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />
                        </StackPanel>

                        <ContentPresenter Content="{Binding RebootPending}"
                                          ContentTemplate="{StaticResource StatusTemplate}"
                                          Margin="0,0,0,2" />

                        <TextBlock Text="{Binding RebootPendingNote}"
                                   Style="{StaticResource ExplanationText}"
                                   FontStyle="Italic"
                                   Margin="0,0,0,8"
                                   Foreground="{DynamicResource Text.Subtle.Brush}" />

                        <DataGrid ItemsSource="{Binding PendingUpdates}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  MaxHeight="240"
                                  AutomationProperties.Name="Pending Windows updates">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Update identifier" Binding="{Binding UpdateId}" Width="Auto" />
                                <DataGridTemplateColumn Header="Classification" Width="Auto"
                                                        SortMemberPath="Classification.Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Classification}"
                                                              ContentTemplate="{StaticResource StatusTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeBytes}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ContentControl Content="{Binding HistoryAvailability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Margin="0,8,0,0" />

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SectionActionsTemplate}" />
                    </StackPanel>
                </Expander>

                <!-- Event Logs -->
                <Expander IsExpanded="{Binding EventLogs.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding EventLogs.Title}"
                          AutomationProperties.HelpText="{Binding EventLogs.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding EventLogs.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding EventLogs}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}"
                                        Visibility="{Binding Availability.ShowsReason,
                                                     Converter={StaticResource BoolToVisibility}}" />

                        <!--
                            A view and a window, not a log picker and a filter
                            box. The views are written once by a Supervisor who
                            knew which four event ids answer the question, and
                            shared with everyone. Nothing here accepts a query
                            expression: the server expands the view's stored
                            fields and the agent builds its own query from them.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Label Content="View"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                            <ComboBox ItemsSource="{Binding Views}"
                                      SelectedItem="{Binding SelectedView}"
                                      DisplayMemberPath="DisplayName"
                                      MinWidth="240"
                                      Margin="0,0,16,0"
                                      AutomationProperties.Name="Event log view to run"
                                      AutomationProperties.HelpText="Defined by Supervisors and shared across every rep." />

                            <Label Content="Window"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                            <ComboBox ItemsSource="{Binding WindowChoices}"
                                      SelectedItem="{Binding SelectedWindow}"
                                      DisplayMemberPath="Label"
                                      MinWidth="180"
                                      AutomationProperties.Name="How far back to look" />
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedView.Description}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource Text.Subtle.Brush}"
                                   AutomationProperties.Name="What this view answers" />

                        <TextBlock Text="{Binding ResultSummary}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="Event log result"
                                   Foreground="{DynamicResource Text.Subtle.Brush}"
                                   Margin="0,0,0,6" />

                        <DataGrid ItemsSource="{Binding Entries}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  MaxHeight="320"
                                  AutomationProperties.Name="Event log records the view matched, newest first">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeCreatedUtc}" Width="Auto" />
                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="Auto" />
                                <DataGridTextColumn Header="Log" Binding="{Binding LogName}" Width="Auto" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="Event" Binding="{Binding EventId}" Width="Auto" />
                                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SectionActionsTemplate}" />
                    </StackPanel>
                </Expander>

                <!-- Network -->
                <Expander IsExpanded="{Binding Network.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding Network.Title}"
                          AutomationProperties.HelpText="{Binding Network.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding Network.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding Network}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}" />

                        <Grid Visibility="{Binding Availability.HasData, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Reaches this server" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="0" Grid.Column="1" Content="{Binding ServerReachable}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Firewall, domain" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="1" Grid.Column="1" Content="{Binding FirewallDomain}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Firewall, private" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="2" Grid.Column="1" Content="{Binding FirewallPrivate}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Firewall, public" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="3" Grid.Column="1" Content="{Binding FirewallPublic}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Proxy" Style="{StaticResource FieldLabel}" />
                            <ContentPresenter Grid.Row="4" Grid.Column="1" Content="{Binding Proxy}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Proxy address" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProxyAddress}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Proxy address" />
                        </Grid>

                        <!--
                            Adapters that are down are listed rather than filtered
                            out: a cabinet on the wrong port is exactly what a rep
                            opening this section is looking for.
                        -->
                        <DataGrid ItemsSource="{Binding Adapters}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  Margin="0,8,0,0"
                                  MaxHeight="220"
                                  Visibility="{Binding Availability.HasData, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Network adapters">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                                <DataGridTextColumn Header="MAC" Binding="{Binding MacAddress}" Width="Auto" />
                                <DataGridTextColumn Header="DHCP" Binding="{Binding DhcpEnabled}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SectionActionsTemplate}" />
                    </StackPanel>
                </Expander>

                <!-- System -->
                <Expander IsExpanded="{Binding System.IsExpanded}"
                          Margin="0,0,0,6"
                          AutomationProperties.Name="{Binding System.Title}"
                          AutomationProperties.HelpText="{Binding System.AccessibleDescription}">
                    <Expander.Header>
                        <TextBlock Text="{Binding System.Title}"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                    </Expander.Header>

                    <StackPanel Margin="12,8,0,8" DataContext="{Binding System}">
                        <ContentControl Content="{Binding Availability}"
                                        ContentTemplate="{StaticResource SectionUnavailableTemplate}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Operating system" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OsVersion}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Operating system" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Build" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsBuild}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Operating system build" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Installed" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallDate}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Operating system install date" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Domain" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Domain}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Domain or workgroup" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Time zone" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TimeZone}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Cabinet time zone" />

                            <!--
                                The cabinet's own clock, shown beside the rep's.
                                A maintenance window is evaluated in this zone,
                                never the server's and never the reader's.
                            -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Cabinet local time" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CabinetLocalTime}" Style="{StaticResource FieldValue}"
                                       AutomationProperties.Name="Cabinet local time" />

                            <!--
                                Its own line because drift breaks site
                                synchronisation and the ordering of audit records
                                against a dispensing system's log, and neither
                                failure announces itself at the time.
                            -->
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Clock drift" Style="{StaticResource FieldLabel}" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ClockDrift}" Style="{StaticResource FieldValue}"
                                           AutomationProperties.Name="Clock drift from the server" />
                                <ContentPresenter Content="{Binding ClockDriftStatus}"
                                                  ContentTemplate="{StaticResource StatusTemplate}"
                                                  Margin="8,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <DataGrid ItemsSource="{Binding InstalledSoftware}"
                                  Style="{StaticResource AccessibleDataGrid}"
                                  Margin="0,8,0,0"
                                  MaxHeight="220"
                                  Visibility="{Binding Availability.HasData, Converter={StaticResource BoolToVisibility}}"
                                  AutomationProperties.Name="Installed software">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" />
                                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SectionActionsTemplate}" />
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
