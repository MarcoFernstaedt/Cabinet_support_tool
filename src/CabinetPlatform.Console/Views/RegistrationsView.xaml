<UserControl x:Class="CabinetPlatform.Console.Views.RegistrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface.Brush}" Foreground="{DynamicResource Text.Brush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Cabinet registrations" FontSize="22" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="Agents contact their configured server automatically. Verify the machine identity independently before accepting it into the fleet. A hostname alone is not identity."
                       TextWrapping="Wrap" Margin="0,6" />
            <StackPanel Orientation="Horizontal">
                <Label Content="_Status" Target="{Binding ElementName=Status}" />
                <ComboBox x:Name="Status" ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusFilter}" Width="140" AutomationProperties.Name="Registration status filter" />
                <Button Content="_Refresh queue" Command="{Binding RefreshCommand}" />
                <Button Content="_Previous" Command="{Binding PreviousCommand}" />
                <Button Content="_Next" Command="{Binding NextCommand}" />
                <TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" Margin="10,0" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,8">
            <TextBlock Text="Loading registrations…" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <DataGrid Grid.Row="2" Style="{StaticResource AccessibleDataGrid}" ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedRegistration}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                  AutomationProperties.Name="Registration queue. Select a machine to review its identity and decide.">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource AccessibleRow}">
                    <Setter Property="AutomationProperties.Name">
                        <Setter.Value>
                            <MultiBinding StringFormat="{}{0}, machine identity {1}, status {2}">
                                <Binding Path="Hostname" />
                                <Binding Path="MachineId" />
                                <Binding Path="Status" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hostname (reported)" Binding="{Binding Hostname}" Width="180" />
                <DataGridTextColumn Header="Machine identity" Binding="{Binding MachineId}" Width="*" />
                <DataGridTextColumn Header="OS" Binding="{Binding OsVersion}" Width="160" />
                <DataGridTextColumn Header="Agent" Binding="{Binding AgentVersion}" Width="70" />
                <DataGridTextColumn Header="First seen (UTC)" Binding="{Binding FirstSeenUtc}" Width="160" />
                <DataGridTextColumn Header="Last seen (UTC)" Binding="{Binding LastSeenUtc}" Width="160" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
            </DataGrid.Columns>
        </DataGrid>
        <ScrollViewer Grid.Row="3" MaxHeight="310" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,12,0,0">
                <TextBlock Text="Selected machine" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{Binding SelectedRegistration.Hostname}" />
                <TextBox Text="{Binding SelectedRegistration.MachineId, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Full selected machine identity, copyable for independent verification" />
                <WrapPanel>
                    <StackPanel Width="210" Margin="0,0,8,0">
                        <Label Content="_Client (required to accept)" Target="{Binding ElementName=Client}" />
                        <TextBox x:Name="Client" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Client name" />
                    </StackPanel>
                    <StackPanel Width="210" Margin="0,0,8,0">
                        <Label Content="_Site (required to accept)" Target="{Binding ElementName=Site}" />
                        <TextBox x:Name="Site" Text="{Binding SiteName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Site name" />
                    </StackPanel>
                    <StackPanel Width="160" Margin="0,0,8,0">
                        <Label Content="Cabinet _role" Target="{Binding ElementName=Role}" />
                        <ComboBox x:Name="Role" ItemsSource="{Binding Roles}" SelectedItem="{Binding CabinetRole}" AutomationProperties.Name="Cabinet role. Choose Sync, Satellite or Standalone." />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,8,0">
                        <Label Content="_Department (optional)" Target="{Binding ElementName=Department}" />
                        <TextBox x:Name="Department" Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Department" />
                    </StackPanel>
                    <StackPanel Width="180">
                        <Label Content="_Ticket (optional)" Target="{Binding ElementName=Ticket}" />
                        <TextBox x:Name="Ticket" Text="{Binding TicketReference, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Support ticket reference" />
                    </StackPanel>
                </WrapPanel>
                <Label Content="Rejection reason (required to reject)" Target="{Binding ElementName=Reason}" />
                <TextBox x:Name="Reason" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AutomationProperties.Name="Rejection reason" />
                <CheckBox Content="I independently verified the selected machine identity and intend this decision."
                          IsChecked="{Binding IdentityConfirmed}" Margin="0,8" AutomationProperties.Name="Confirm selected machine identity before accepting or rejecting" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="_Accept and activate" Command="{Binding AcceptCommand}" AutomationProperties.Name="Accept selected registration and activate the cabinet" />
                    <Button Content="Re_ject registration" Command="{Binding RejectCommand}" AutomationProperties.Name="Reject selected registration. Agent retries remain rejected." />
                    <TextBlock Text="Only Pending rows can be decided. Rejection cannot be undone here." VerticalAlignment="Center" Margin="10,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
