<UserControl x:Class="CabinetPlatform.Console.Views.FleetTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface.Brush}">

    <UserControl.Resources>
        <!--
            A count breakdown as a table: label, shape, number. No pie chart,
            because a pie chart of six statuses is harder to read than six rows
            and impossible to read aloud.
        -->
        <Style x:Key="CountGrid" TargetType="DataGrid" BasedOn="{StaticResource AccessibleDataGrid}">
            <Setter Property="MaxHeight" Value="220" />
            <Setter Property="CanUserSortColumns" Value="True" />
        </Style>

        <!-- One worklist: a cabinet grid with a heading and a count. -->
        <Style x:Key="WorklistGrid" TargetType="DataGrid" BasedOn="{StaticResource AccessibleDataGrid}">
            <Setter Property="MaxHeight" Value="260" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8">

        <!-- ========================= Filters ========================= -->
        <StackPanel DockPanel.Dock="Top">

            <TextBlock Text="Fleet health"
                       Style="{StaticResource SectionHeading}"
                       FontSize="17"
                       AutomationProperties.HeadingLevel="Level2" />

            <TextBlock Text="Aggregate health across every cabinet the server will show you. This is the view a remote desktop session cannot produce."
                       Style="{StaticResource ExplanationText}"
                       Foreground="{DynamicResource Text.Subtle.Brush}"
                       Margin="0,0,0,8" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ClientFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter the fleet by client" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Site" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding SiteFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter the fleet by site" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Apply"
                            Command="{Binding RefreshCommand}"
                            IsDefault="True"
                            AutomationProperties.Name="Apply the fleet filters" />
                    <Button Content="Clear"
                            Command="{Binding ClearFiltersCommand}"
                            AutomationProperties.Name="Clear the fleet filters" />
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                         AutomationProperties.Name="Loading fleet health"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Fleet health problem"
                           Foreground="{DynamicResource Severity.Critical.Brush}" />
            </Border>

            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding WorklistsTruncated, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding TruncationNote}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.Name="Worklist completeness"
                           Foreground="{DynamicResource Severity.Warning.Brush}" />
            </Border>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>

                <!-- The headline, as one sentence. Also what the live region says. -->
                <Border Style="{StaticResource ExplanationPanel}">
                    <StackPanel>
                        <TextBlock Text="Summary"
                                   FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level3"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SummaryText}"
                                   Style="{StaticResource ExplanationText}"
                                   AutomationProperties.Name="Fleet summary" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="{DynamicResource Text.Subtle.Brush}">
                            <Run Text="Generated" />
                            <Run Text="{Binding GeneratedAt, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="All cabinets by site"
                           Style="{StaticResource SectionHeading}"
                           Margin="0,12,0,4"
                           AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Text="Active and inactive cabinets under the applied client and site filters. Expand a site to open a cabinet. Use Find cabinet above to look up any cabinet by name, serial number or cabinet id."
                           Style="{StaticResource ExplanationText}"
                           Foreground="{DynamicResource Text.Subtle.Brush}"
                           Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Sites}"
                              AutomationProperties.Name="Fleet cabinets grouped by client and site">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,6"
                                      AutomationProperties.Name="{Binding AccessibleSummary}">
                                <Expander.Header>
                                    <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" />
                                </Expander.Header>
                                <DataGrid ItemsSource="{Binding Cabinets}"
                                          Style="{StaticResource WorklistGrid}"
                                          AutomationProperties.Name="{Binding AccessibleSummary}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Open" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Open cabinet"
                                                            Command="{Binding DataContext.Finder.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Id}"
                                                            AutomationProperties.Name="{Binding AccessibleSummary}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding RoleLabel}" Width="Auto" />
                                        <DataGridTextColumn Header="Active" Binding="{Binding ActiveLabel}" Width="Auto" />
                                        <DataGridTemplateColumn Header="Health" Width="Auto" SortMemberPath="Summary.Health">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ContentPresenter Content="{Binding Health}"
                                                                      ContentTemplate="{StaticResource StatusTemplate}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Last check-in" Binding="{Binding LastCheckInAge}"
                                                            SortMemberPath="Summary.LastCheckInUtc" Width="Auto" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cabinets by health"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                        <DataGrid ItemsSource="{Binding CabinetHealthCounts}"
                                  Style="{StaticResource CountGrid}"
                                  AutomationProperties.Name="Cabinet counts by rolled-up health, as evaluated by the server">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}"
                                                              ContentTemplate="{StaticResource StatusTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cabinets" Binding="{Binding Count}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cabinets by worst drive health"
                                   Style="{StaticResource SectionHeading}"
                                   AutomationProperties.HeadingLevel="Level3" />
                        <DataGrid ItemsSource="{Binding DiskHealthCounts}"
                                  Style="{StaticResource CountGrid}"
                                  AutomationProperties.Name="Cabinet counts by the worst drive health each one reports. Not reported is kept separate from healthy.">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Drive health" Width="*" SortMemberPath="Label">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Status}"
                                                              ContentTemplate="{StaticResource StatusTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Cabinets" Binding="{Binding Count}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>

                <!-- Worklists -->
                <TextBlock Text="Not checked in recently"
                           Style="{StaticResource SectionHeading}"
                           Margin="0,16,0,4"
                           AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Text="Cabinets that have gone quiet, never-reported first. An approved cabinet that has never checked in is the more urgent case."
                           Style="{StaticResource ExplanationText}"
                           Foreground="{DynamicResource Text.Subtle.Brush}"
                           Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding StaleCheckIns}"
                          Style="{StaticResource WorklistGrid}"
                          AutomationProperties.Name="Cabinets that have not checked in recently">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" />
                        <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="Auto" />
                        <DataGridTextColumn Header="Last check-in" Binding="{Binding LastCheckInAge}"
                                            SortMemberPath="Summary.LastCheckInUtc" Width="Auto" />
                        <DataGridTextColumn Header="Exact time" Binding="{Binding LastCheckInExact}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Pending Windows updates"
                           Style="{StaticResource SectionHeading}"
                           Margin="0,16,0,4"
                           AutomationProperties.HeadingLevel="Level3" />
                <DataGrid ItemsSource="{Binding PendingUpdates}"
                          Style="{StaticResource WorklistGrid}"
                          AutomationProperties.Name="Cabinets with pending Windows updates, most first">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" />
                        <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="Auto" />
                        <DataGridTextColumn Header="Pending updates" Binding="{Binding PendingUpdates}"
                                            SortMemberPath="Summary.PendingUpdateCount" Width="Auto" />
                        <DataGridTextColumn Header="Last check-in" Binding="{Binding LastCheckInAge}"
                                            SortMemberPath="Summary.LastCheckInUtc" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Drives in watch or failing"
                           Style="{StaticResource SectionHeading}"
                           Margin="0,16,0,4"
                           AutomationProperties.HeadingLevel="Level3" />
                <TextBlock Text="A drive that has started reallocating sectors is the one fault worth acting on before anybody in a clinic notices it."
                           Style="{StaticResource ExplanationText}"
                           Foreground="{DynamicResource Text.Subtle.Brush}"
                           Margin="0,0,0,4" />
                <DataGrid ItemsSource="{Binding DrivesNeedingAttention}"
                          Style="{StaticResource WorklistGrid}"
                          AutomationProperties.Name="Cabinets whose worst drive is in watch, failing or failed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                        <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" />
                        <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="Auto" />
                        <DataGridTemplateColumn Header="Worst drive" Width="Auto"
                                                SortMemberPath="Summary.WorstDiskHealth">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter Content="{Binding DiskHealth}"
                                                      ContentTemplate="{StaticResource StatusTemplate}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Free disk" Binding="{Binding FreeDisk}"
                                            SortMemberPath="Summary.MinFreeDiskPercent" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
