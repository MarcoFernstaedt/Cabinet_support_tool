<Window x:Class="CabinetPlatform.Console.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:a11y="clr-namespace:CabinetPlatform.Console.Accessibility"
        xmlns:views="clr-namespace:CabinetPlatform.Console.Views"
        Title="Mashura Support Console"
        Width="1440"
        Height="900"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Brush}"
        Foreground="{DynamicResource Text.Brush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshAllCommand}" />
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ShowCabinetsCommand}" />
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding ShowApprovalsCommand}" />

        <!--
            Ctrl+F from anywhere. Finding the right cabinet among seven thousand
            is the most frequent thing anybody does here, and a rep taking a
            second call should not have to navigate away from the first one's
            cabinet to start looking.
        -->
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding ShowFinderCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ========================= Header ========================= -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Alt.Brush}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <TextBlock Text="Mashura Support Console"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <TextBlock Text="{Binding SignedInAs}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"
                               AutomationProperties.Name="Signed in as"
                               Foreground="{DynamicResource Text.Subtle.Brush}" />

                    <Button Content="Cabinets"
                            Command="{Binding ShowCabinetsCommand}"
                            AutomationProperties.Name="Show cabinets. Keyboard shortcut Control L."
                            AutomationProperties.AcceleratorKey="Ctrl+L" />

                    <Button Content="_Registrations"
                            Command="{Binding ShowRegistrationsCommand}"
                            Visibility="{Binding CanSeeRegistrations, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Supervisor cabinet registrations" />

                    <Button Content="Find"
                            Command="{Binding ShowFinderCommand}"
                            AutomationProperties.Name="Find a cabinet by search, by client hierarchy, or from the ones you looked at recently. Keyboard shortcut Control F."
                            AutomationProperties.AcceleratorKey="Ctrl+F" />

                    <Button Command="{Binding ShowApprovalsCommand}"
                            Visibility="{Binding CanSeeApprovals, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="{Binding ApprovalBadgeAccessibleText}"
                            AutomationProperties.AcceleratorKey="Ctrl+A">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Approvals" />
                            <!--
                                The badge is a number in a border, and the count
                                is also in the button's accessible name above.
                                A coloured dot alone would say nothing to anyone
                                not looking at it.
                            -->
                            <Border Margin="6,0,0,0"
                                    Padding="6,0"
                                    CornerRadius="8"
                                    Background="{DynamicResource Severity.Warning.Brush}"
                                    Visibility="{Binding ApprovalBadge, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Text="{Binding ApprovalBadge}"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           AutomationProperties.Name="{Binding ApprovalBadge}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <!--
                        The shortest path from "this cabinet is misbehaving" to
                        "here is what has been done to it". Every rep can read
                        the trail: with no case scoping and no per-rep cabinet
                        assignment, it is the control that replaces them.
                    -->
                    <Button Content="Audit this cabinet"
                            Command="{Binding ShowAuditForSelectedCabinetCommand}"
                            MinWidth="130"
                            Visibility="{Binding CanSeeAudit, Converter={StaticResource BoolToVisibility}}"
                            AutomationProperties.Name="Show the audit trail for the selected cabinet" />

                    <Button Content="Refresh"
                            Command="{Binding RefreshAllCommand}"
                            AutomationProperties.Name="Refresh everything. Keyboard shortcut F5."
                            AutomationProperties.AcceleratorKey="F5" />

                    <Button Content="Sign out"
                            Command="{Binding SignOutCommand}"
                            AutomationProperties.Name="Sign out and discard the access token" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ====================== Search bar ====================== -->
        <!--
            Persistent, on every screen, and the first thing in the tab order
            below the header. It is not inside the cabinet list, because a rep
            looking at the fleet view or the approvals queue needs it just as
            much and should not have to leave where they are.
        -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Surface.Brush}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                DataContext="{Binding Finder}">
            <DockPanel>
                <Label DockPanel.Dock="Left"
                       Content="_Find cabinet"
                       Target="{Binding ElementName=GlobalSearchBox}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

                <Button DockPanel.Dock="Right"
                        Content="Clear"
                        Command="{Binding ClearSearchCommand}"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Clear the search" />

                <Button DockPanel.Dock="Right"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        IsDefault="False"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Run the search" />

                <TextBox x:Name="GlobalSearchBox"
                         Text="{Binding Term, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         AutomationProperties.Name="Find a cabinet by client, site, department, cabinet name, serial number or cabinet id"
                         AutomationProperties.HelpText="Partial matches work. Results show the full path: client, site, department, cabinet name and role."
                         AutomationProperties.AcceleratorKey="Ctrl+F"
                         ToolTip="Client, site, department, cabinet name, serial number or cabinet id. Ctrl+F from anywhere.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- ====================== Live region ====================== -->
        <!--
            One live region for the whole window, at the bottom, where a status
            bar belongs. Every asynchronous result in this console arrives here
            as well as on screen — that is what makes a refreshed grid, a
            submitted action and a server refusal perceivable without sight.
        -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Surface.Alt.Brush}"
                BorderBrush="{DynamicResource Border.Brush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock x:Name="LiveRegionText"
                       a11y:LiveRegion.Text="{Binding Announcement}"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="Status"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Text.Brush}" />
        </Border>

        <!-- ========================= Body ========================= -->
        <Grid>
            <!--
                Cabinets: list on the left, detail tabs on the right.
                Visibility comes from the style trigger alone — a local
                Visibility attribute here would outrank the trigger and pin the
                panel open.
            -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Cabinets">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" MinWidth="360" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" MinWidth="520" />
                </Grid.ColumnDefinitions>

                <views:CabinetListView Grid.Column="0" DataContext="{Binding Cabinets}" />

                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource Border.Brush}"
                              AutomationProperties.Name="Resize the cabinet list" />

                <TabControl Grid.Column="2"
                            Margin="8"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Background="{DynamicResource Surface.Brush}"
                            KeyboardNavigation.TabNavigation="Local">

                    <TabItem Header="Machine" AutomationProperties.Name="Machine tab">
                        <views:MachineTabView DataContext="{Binding Machine}" />
                    </TabItem>

                    <TabItem Header="Cabinet" AutomationProperties.Name="Cabinet tab">
                        <views:CabinetTabView DataContext="{Binding Cabinet}" />
                    </TabItem>

                    <TabItem Header="Audit"
                             AutomationProperties.Name="Audit tab"
                             Visibility="{Binding CanSeeAudit, Converter={StaticResource BoolToVisibility}}">
                        <views:AuditTabView DataContext="{Binding Audit}" />
                    </TabItem>

                    <TabItem Header="Fleet" AutomationProperties.Name="Fleet tab">
                        <views:FleetTabView DataContext="{Binding Fleet}" />
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Find a cabinet -->
            <views:CabinetFinderView DataContext="{Binding Finder}">
                <views:CabinetFinderView.Style>
                    <Style TargetType="views:CabinetFinderView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentView,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Find">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:CabinetFinderView.Style>
            </views:CabinetFinderView>

            <views:RegistrationsView DataContext="{Binding Registrations}">
                <views:RegistrationsView.Style>
                    <Style TargetType="views:RegistrationsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentView, RelativeSource={RelativeSource AncestorType=Window}}" Value="Registrations">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:RegistrationsView.Style>
            </views:RegistrationsView>

            <!-- Approvals -->
            <views:ApprovalsView DataContext="{Binding Approvals}">
                <views:ApprovalsView.Style>
                    <Style TargetType="views:ApprovalsView">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.CurrentView,
                                                   RelativeSource={RelativeSource AncestorType=Window}}"
                                         Value="Approvals">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ApprovalsView.Style>
            </views:ApprovalsView>
        </Grid>
    </DockPanel>
</Window>
