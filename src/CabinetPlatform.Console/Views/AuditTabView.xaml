<UserControl x:Class="CabinetPlatform.Console.Views.AuditTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface.Brush}"
             Foreground="{DynamicResource Text.Brush}">

    <DockPanel Margin="8">

        <!-- ========================= Filters ========================= -->
        <StackPanel DockPanel.Dock="Top">

            <TextBlock Text="Audit trail"
                       Style="{StaticResource SectionHeading}"
                       FontSize="17"
                       AutomationProperties.HeadingLevel="Level2" />

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Cabinet" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Cabinets}"
                              SelectedItem="{Binding SelectedCabinet}"
                              DisplayMemberPath="Hostname"
                              AutomationProperties.Name="Filter by cabinet"
                              AutomationProperties.HelpText="Leave unset to include every cabinet." />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Observed or caused" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding EventKindChoices}"
                              SelectedValue="{Binding EventKind}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Filter by whether the entry only observed something or changed cabinet state"
                              AutomationProperties.HelpText="Caused means state on a cabinet changed, or was requested or approved to change." />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Result" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ResultChoices}"
                              SelectedValue="{Binding Result}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Filter by result" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="From (local time)" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding FromLocal}"
                                AutomationProperties.Name="Start of the date range, in local time" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="To (local time)" Style="{StaticResource FieldLabel}" />
                    <DatePicker SelectedDate="{Binding ToLocal}"
                                AutomationProperties.Name="End of the date range, in local time"
                                AutomationProperties.HelpText="The server refuses ranges wider than 90 days." />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Actor identifier" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ActorId, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter by the user or agent identifier that produced the entry" />
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock Text="Action" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Filter by the audited action name" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        IsDefault="True"
                        AutomationProperties.Name="Search the audit trail" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh the audit trail" />
            </StackPanel>

            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding IsForbidden, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ForbiddenExplanation}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Audit access" />
            </Border>

            <Border Style="{StaticResource ExplanationPanel}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource ExplanationText}"
                           AutomationProperties.LiveSetting="Assertive"
                           AutomationProperties.Name="Audit query problem"
                           Foreground="{DynamicResource Severity.Critical.Brush}" />
            </Border>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                         AutomationProperties.Name="Loading audit entries"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ========================= Paging ========================= -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <TextBlock Text="{Binding PageSummary}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Audit result count"
                       Foreground="{DynamicResource Text.Subtle.Brush}"
                       Margin="0,0,0,4" />

            <StackPanel Orientation="Horizontal">
                <Button Content="Previous"
                        Command="{Binding PreviousPageCommand}"
                        MinWidth="80"
                        AutomationProperties.Name="Previous page of audit entries" />
                <Button Content="Next"
                        Command="{Binding NextPageCommand}"
                        MinWidth="80"
                        AutomationProperties.Name="Next page of audit entries" />

                <TextBlock Text="Per page" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox ItemsSource="{Binding PageSizes}"
                          SelectedItem="{Binding PageSize}"
                          MinWidth="70"
                          AutomationProperties.Name="Audit entries shown per page" />
            </StackPanel>
        </StackPanel>

        <!-- ========================== Grid ========================== -->
        <DataGrid ItemsSource="{Binding Entries}"
                  Style="{StaticResource AccessibleDataGrid}"
                  AutomationProperties.Name="Audit entries">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}"
                                    SortMemberPath="TimestampUtc" Width="Auto" />

                <DataGridTemplateColumn Header="Kind" Width="Auto" SortMemberPath="Kind.Label">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Kind}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*" />
                <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="Auto" />
                <DataGridTextColumn Header="Actor type" Binding="{Binding ActorType}" Width="Auto" />
                <DataGridTextColumn Header="Cabinet" Binding="{Binding Hostname}" Width="Auto" />

                <DataGridTemplateColumn Header="Result" Width="Auto" SortMemberPath="Result.Label">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Result}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" />
                <DataGridTextColumn Header="Ticket" Binding="{Binding Ticket}" Width="Auto" />
                <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
