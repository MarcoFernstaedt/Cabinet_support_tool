<UserControl x:Class="CabinetPlatform.Console.Views.CabinetListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface.Brush}"
             Foreground="{DynamicResource Text.Brush}">

    <DockPanel Margin="8">

        <!-- ========================= Filters ========================= -->
        <StackPanel DockPanel.Dock="Top">

            <TextBlock Text="Cabinets"
                       Style="{StaticResource SectionHeading}"
                       AutomationProperties.HeadingLevel="Level2" />

            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        IsDefault="True"
                        MinWidth="80"
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Search cabinets" />

                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search by hostname, client, site or serial number"
                         AutomationProperties.HelpText="Press Enter or choose Search to apply." />
            </DockPanel>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Client" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding KnownClients}"
                              SelectedItem="{Binding ClientFilter}"
                              IsEditable="True"
                              Text="{Binding ClientFilter, UpdateSourceTrigger=LostFocus}"
                              AutomationProperties.Name="Filter by client"
                              AutomationProperties.HelpText="{Binding ClientFilterNote}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Site" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding KnownSites}"
                              SelectedItem="{Binding SiteFilter}"
                              IsEditable="True"
                              Text="{Binding SiteFilter, UpdateSourceTrigger=LostFocus}"
                              AutomationProperties.Name="Filter by site" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Health" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding HealthChoices}"
                              SelectedValue="{Binding HealthFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Filter by health status" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Active" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ActiveChoices}"
                              SelectedValue="{Binding ActiveFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Filter by whether the cabinet is active" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        AutomationProperties.Name="Clear all filters" />
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        AutomationProperties.Name="Refresh the cabinet list" />
            </StackPanel>
        </StackPanel>

        <!-- ========================= Paging ========================= -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">

            <TextBlock Text="{Binding PageSummary}"
                       AutomationProperties.LiveSetting="Polite"
                       AutomationProperties.Name="Result count"
                       Foreground="{DynamicResource Text.Subtle.Brush}"
                       Margin="0,0,0,4" />

            <StackPanel Orientation="Horizontal">
                <Button Content="Previous"
                        Command="{Binding PreviousPageCommand}"
                        MinWidth="80"
                        AutomationProperties.Name="Previous page of cabinets" />
                <Button Content="Next"
                        Command="{Binding NextPageCommand}"
                        MinWidth="80"
                        AutomationProperties.Name="Next page of cabinets" />

                <TextBlock Text="Per page" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox ItemsSource="{Binding PageSizes}"
                          SelectedItem="{Binding PageSize}"
                          MinWidth="70"
                          AutomationProperties.Name="Cabinets shown per page" />
            </StackPanel>
        </StackPanel>

        <!-- ========================= Status ========================= -->
        <Border DockPanel.Dock="Top"
                Style="{StaticResource ExplanationPanel}"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Style="{StaticResource ExplanationText}"
                       AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="Cabinet list problem"
                       Foreground="{DynamicResource Severity.Critical.Brush}" />
        </Border>

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     Height="4"
                     Margin="0,0,0,4"
                     AutomationProperties.Name="Loading cabinets"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

        <!-- ========================== Grid ========================== -->
        <DataGrid ItemsSource="{Binding Cabinets}"
                  SelectedItem="{Binding SelectedCabinet}"
                  Style="{StaticResource AccessibleDataGrid}"
                  AutomationProperties.Name="Cabinets. Select a row to see its detail on the right.">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname}" Width="*" />
                <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" Width="*" />
                <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="Auto" />

                <DataGridTemplateColumn Header="Health" Width="Auto" SortMemberPath="Summary.Health">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding Health}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Disk" Width="Auto" SortMemberPath="Summary.WorstDiskHealth">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ContentPresenter Content="{Binding DiskHealth}"
                                              ContentTemplate="{StaticResource StatusTemplate}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Last check-in"
                                    Binding="{Binding LastCheckInAge}"
                                    SortMemberPath="Summary.LastCheckInUtc"
                                    Width="Auto" />
                <DataGridTextColumn Header="Pending updates"
                                    Binding="{Binding PendingUpdates}"
                                    SortMemberPath="Summary.PendingUpdateCount"
                                    Width="Auto" />
                <DataGridTextColumn Header="Active"
                                    Binding="{Binding ActiveLabel}"
                                    SortMemberPath="Summary.IsActive"
                                    Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
