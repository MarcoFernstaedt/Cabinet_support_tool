<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CabinetPlatform.Agent.Tests</RootNamespace>
    <AssemblyName>CabinetPlatform.Agent.Tests</AssemblyName>
    <!-- Matches the agent it exercises; verified to run on non-Windows CI
         because the tested code paths take Windows access through injected
         abstractions rather than calling WMI directly. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The agent's real configuration file, asserted against rather than a
         copy that could drift away from it. -->
    <None Include="..\..\src\CabinetPlatform.Agent\appsettings.json"
          Link="appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CabinetPlatform.Contracts\CabinetPlatform.Contracts.csproj" />
    <ProjectReference Include="..\..\src\CabinetPlatform.Console.Core\CabinetPlatform.Console.Core.csproj" />
    <ProjectReference Include="..\..\src\CabinetPlatform.Server\CabinetPlatform.Server.csproj" />
    <!-- Reuse the real API host without retargeting the portable Console tests. -->
    <Compile Include="..\CabinetPlatform.Console.Core.Tests\ConsoleTestHost.cs" Link="Integration\ConsoleTestHost.cs" />
    <Compile Include="..\CabinetPlatform.Console.Core.Tests\TestDialogs.cs" Link="Integration\TestDialogs.cs" />
    <ProjectReference Include="..\..\src\CabinetPlatform.Agent\CabinetPlatform.Agent.csproj" />
  </ItemGroup>

</Project>
