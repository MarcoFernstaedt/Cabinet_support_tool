# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo

# Local databases — real deployments point at a configured connection string
*.db
*.db-shm
*.db-wal

# Local secrets and local overrides. Nothing in this repository contains a
# usable credential, and nothing that does may be added to it: supply
# Jwt__SigningKey, AgentAuth__SharedSecret and Seed__SupervisorInitialPassword
# through the environment or the platform's secret store.
appsettings.Local.json
appsettings.*.local.json
secrets.json
# Office enrollment material is generated outside the repository, never committed.
office-enrollment.json*
*.device
__pycache__/
*.pyc
*.pfx
*.snk
*.p12

# Agent runtime state, written next to the installed service. None of it is
# source: the machine id and cabinet id are per-machine, and the spooled
# payloads and diagnostic bundles contain a cabinet's own diagnostic data.
state/
buffer/
bundles/
logs/

# OS
.DS_Store
Thumbs.db
# Simulated demo agent identities (synthetic, per machine)
tools/demo-agent/.demo-agent-state.json
# Node packages and build output for the spec rebuild (contracts/, server/, console/)
node_modules
server/dist/
agent/out/
server/.dev-pki/
console/dist/

# The software library's stored packages (server/PACKAGE_DIR default)
/data/
# Platform: never commit environment files, private keys or load-test identities (which hold private keys).
.env
.env.*
*.key
*-key.pem
*.private.pem
load-state*.json
# Server stores (packages and agent releases) live outside source control.
data/
# Demo deployment (deploy/): the real environment file holds generated secrets; only the example is committed.
deploy/.env
!deploy/.env.example

# Local tool state and credentials can land here and must never be committed.
/.agents/
/.aws/
/.codex/
.claude/worktrees/

# Personal, per-host deployment files; nothing personal goes in the repo.
deploy/Caddyfile.gate
deploy/compose.local.yaml
# Local deployment overrides (examples in deploy/examples/)
deploy/compose.override.yaml
deploy/Caddyfile.local
# Load harness reports and server logs (server/test/load/run.sh)
server/load-results/

# Real deployment environment files at any depth; templates contain placeholders only.
deploy/**/*.env
deploy/env/*.env
!deploy/**/*.env.example

# One-off staged inputs for a worker run (never committed).
.staging/
