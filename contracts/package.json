{
  "name": "@mashura/cabinet-contracts",
  "private": true,
  "version": "1.0.0",
  "description": "JSON Schema contracts shared by the agent, server and console. The schemas are the source of truth.",
  "type": "module",
  "exports": {
    "./schemas/*": "./schemas/*",
    "./types": {
      "types": "./generated/ts/contracts.d.ts"
    },
    "./load": {
      "types": "./load.d.mts",
      "default": "./load.mjs"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-ts.mjs",
    "check-generated": "node scripts/generate-ts.mjs --check",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0"
  }
}
