{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/agent/broker-request.schema.json",
  "title": "broker-request",
  "description": "One typed request from the network process to the broker over the local pipe. The broker accepts only these operations and validates the parameters again itself. There is no field that can carry a command line, path to run or script.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "kind"
  ],
  "properties": {
    "requestId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ping",
        "operation"
      ]
    },
    "operation": {
      "description": "Operations the broker performs: reads that need administrator rights. Write operations are added in milestone 5.",
      "type": "string",
      "enum": [
        "eventlog.channels",
        "eventlog.query",
        "eventlog.get",
        "disk.smart",
        "files.list"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "operation"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "operation",
          "params"
        ]
      },
      "else": {
        "type": "object",
        "not": {
          "anyOf": [
            {
              "required": [
                "operation"
              ]
            },
            {
              "required": [
                "params"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "eventlog.channels"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/eventlog.channels.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "eventlog.query"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/eventlog.query.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "eventlog.get"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/eventlog.get.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "disk.smart"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/disk.smart.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "files.list"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/files.list.schema.json#/$defs/params"
          }
        }
      }
    }
  ]
}
