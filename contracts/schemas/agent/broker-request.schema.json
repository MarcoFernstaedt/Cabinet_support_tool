{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/agent/broker-request.schema.json",
  "title": "broker-request",
  "description": "One typed request from the network process to the broker over the local pipe. The broker accepts only these operations and validates the parameters again itself. There is no field that can carry a command line, a path to run, a file path or a script. package.install names a package ID only, and upgrade names a version only; the broker finds the downloaded files itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "kind"
  ],
  "properties": {
    "requestId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "ping",
        "operation",
        "confirm",
        "upgrade"
      ]
    },
    "operation": {
      "description": "Operations the broker performs: reads that need administrator rights, and every write operation.",
      "type": "string",
      "enum": [
        "eventlog.channels",
        "eventlog.query",
        "eventlog.get",
        "updates.status",
        "disk.smart",
        "files.list",
        "network.setIp",
        "network.setDns",
        "firewall.setProfile",
        "firewall.applyPolicy",
        "firewall.setRule",
        "firewall.restore",
        "package.install",
        "driver.uninstall"
      ]
    },
    "params": {
      "type": "object"
    },
    "commandId": {
      "description": "The platform command a write belongs to. Required for writes, so the safety net and firewall attribution know which command made a change; and for confirm.",
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "version": {
      "description": "For upgrade: the agent release the network process downloaded. The broker verifies it in full before anything is installed.",
      "$ref": "../common.schema.json#/$defs/agentVersion"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "operation"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "operation",
          "params"
        ]
      },
      "else": {
        "type": "object",
        "not": {
          "anyOf": [
            {
              "required": [
                "operation"
              ]
            },
            {
              "required": [
                "params"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "confirm"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "commandId"
        ]
      },
      "else": {
        "if": {
          "type": "object",
          "properties": {
            "operation": {
              "enum": [
                "network.setIp",
                "network.setDns",
                "firewall.setProfile",
                "firewall.applyPolicy",
                "firewall.setRule",
                "firewall.restore",
                "package.install",
                "driver.uninstall"
              ]
            }
          },
          "required": [
            "operation"
          ]
        },
        "then": {
          "type": "object",
          "required": [
            "commandId"
          ]
        },
        "else": {
          "type": "object",
          "not": {
            "required": [
              "commandId"
            ]
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "eventlog.channels"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/eventlog.channels.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "eventlog.query"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/eventlog.query.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "eventlog.get"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/eventlog.get.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "disk.smart"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/disk.smart.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "files.list"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/files.list.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "updates.status"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/updates.status.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "network.setIp"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/network.setIp.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "network.setDns"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/network.setDns.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "firewall.setProfile"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/firewall.setProfile.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "firewall.applyPolicy"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/firewall.applyPolicy.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "firewall.setRule"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/firewall.setRule.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "firewall.restore"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/firewall.restore.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "package.install"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/package.install.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "operation": {
            "const": "driver.uninstall"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "params": {
            "$ref": "../operations/driver.uninstall.schema.json#/$defs/params"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "upgrade"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "version"
        ]
      },
      "else": {
        "type": "object",
        "not": {
          "required": [
            "version"
          ]
        }
      }
    }
  ]
}
