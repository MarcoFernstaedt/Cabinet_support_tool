{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/agent/broker-response.schema.json",
  "title": "broker-response",
  "description": "The broker's answer to one request. output only when succeeded, error only when failed. The network process validates output against the operation's output schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "status"
  ],
  "properties": {
    "requestId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "output": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/rejectionCode"
            },
            {
              "$ref": "../common.schema.json#/$defs/failureCode"
            }
          ]
        },
        "message": {
          "allOf": [
            {
              "$ref": "../common.schema.json#/$defs/shortText"
            },
            {
              "type": "string",
              "maxLength": 1024
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "output"
        ],
        "not": {
          "required": [
            "error"
          ]
        }
      },
      "else": {
        "type": "object",
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "output"
          ]
        }
      }
    }
  ]
}
