{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/eventlog.query.schema.json",
  "title": "eventlog.query",
  "description": "Entries from one allowed log, newest first, filtered and paged.",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log": {
          "$ref": "../common.schema.json#/$defs/allowedLog"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/eventLevel"
          }
        },
        "from": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "to": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "source": {
          "$ref": "../common.schema.json#/$defs/nonEmptyShortText"
        },
        "eventIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/eventId"
          }
        },
        "beforeRecordId": {
          "description": "Paging cursor: return entries older than this record.",
          "$ref": "../common.schema.json#/$defs/recordId"
        },
        "pageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 100
        }
      },
      "required": [
        "log"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log": {
          "$ref": "../common.schema.json#/$defs/allowedLog"
        },
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recordId": {
                "$ref": "../common.schema.json#/$defs/recordId"
              },
              "time": {
                "$ref": "../common.schema.json#/$defs/timestamp"
              },
              "level": {
                "$ref": "../common.schema.json#/$defs/eventLevel"
              },
              "source": {
                "$ref": "../common.schema.json#/$defs/shortText"
              },
              "eventId": {
                "$ref": "../common.schema.json#/$defs/eventId"
              },
              "firstLine": {
                "allOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/shortText"
                  },
                  {
                    "maxLength": 256,
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "recordId",
              "time",
              "level",
              "source",
              "eventId",
              "firstLine"
            ]
          }
        },
        "nextBeforeRecordId": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/recordId"
            },
            {
              "type": "null"
            }
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "log",
        "entries",
        "nextBeforeRecordId",
        "truncated"
      ]
    }
  }
}
