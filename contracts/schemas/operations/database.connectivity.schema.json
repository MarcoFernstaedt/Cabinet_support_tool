{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/database.connectivity.schema.json",
  "title": "database.connectivity",
  "description": "Whether a SQL Server answers on the site's sync cabinet, step by step: TCP, a login-free TDS pre-login, and the TLS handshake inside it. No credential is sent, no login is made, no query runs, and it is never a connection to the cabinet application's database: only the pre-login and TLS handshake that come before any login (docs/platform/archive/diagnostic-engine-execution.md, decision 7). Runs in the unprivileged network service.",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "description": "The port to check. The agent accepts it only if it is in its local allowed-port list or one of the site's sync ports.",
          "$ref": "../common.schema.json#/$defs/port"
        },
        "syncAddress": {
          "description": "The site's sync cabinet as set in the console, filled in by the server. The agent accepts it only if it is a private IPv4 address on one of the cabinet's own connected networks.",
          "$ref": "../common.schema.json#/$defs/ipv4"
        },
        "syncPorts": {
          "description": "TCP ports the site's settings allow for the sync cabinet, filled in by the server.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/port"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "address",
        "result",
        "tcp",
        "prelogin",
        "tls",
        "error"
      ],
      "properties": {
        "port": {
          "$ref": "../common.schema.json#/$defs/port"
        },
        "address": {
          "description": "The address checked; null when the cabinet has no sync cabinet to check.",
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/ipv4"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "description": "sql_server: a SQL Server answered the pre-login. not_sql_server: something listens but did not answer as SQL Server. refused: the port is closed. no_answer: nothing came back in time. unreachable: the network could not reach the address. no_sync_cabinet: there is no sync cabinet address to check.",
          "type": "string",
          "enum": [
            "sql_server",
            "not_sql_server",
            "refused",
            "no_answer",
            "unreachable",
            "no_sync_cabinet"
          ]
        },
        "tcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connected",
            "ms"
          ],
          "properties": {
            "connected": {
              "type": "boolean"
            },
            "ms": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "prelogin": {
          "description": "Null when TCP did not connect.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "answered",
                "ms",
                "serverVersion",
                "encryption"
              ],
              "properties": {
                "answered": {
                  "type": "boolean"
                },
                "ms": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "serverVersion": {
                  "description": "major.minor.build as the server reports it, for example 16.0.4305.",
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,5}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "encryption": {
                  "description": "What the server said about encryption: off (only the login is encrypted), on, required, not_supported (it has no certificate).",
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "off",
                        "on",
                        "required",
                        "not_supported"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        },
        "tls": {
          "description": "Null when the pre-login was not answered or the server does not support encryption. The handshake ends there: nothing is sent over it.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "completed",
                "ms",
                "protocol",
                "certificate",
                "problems"
              ],
              "properties": {
                "completed": {
                  "type": "boolean"
                },
                "ms": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "protocol": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "tls1.0",
                        "tls1.1",
                        "tls1.2",
                        "tls1.3",
                        "other"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "certificate": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "subject",
                        "issuer",
                        "notAfter",
                        "sha256",
                        "selfSigned"
                      ],
                      "properties": {
                        "subject": {
                          "$ref": "../common.schema.json#/$defs/shortText"
                        },
                        "issuer": {
                          "$ref": "../common.schema.json#/$defs/shortText"
                        },
                        "notAfter": {
                          "$ref": "../common.schema.json#/$defs/timestamp"
                        },
                        "sha256": {
                          "$ref": "../common.schema.json#/$defs/sha256"
                        },
                        "selfSigned": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                },
                "problems": {
                  "description": "Why the certificate would not be trusted by a client that checks it: name_mismatch (it does not name the address), untrusted_chain (it does not chain to a trusted root, or has expired), missing (none was presented).",
                  "type": "array",
                  "maxItems": 3,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "name_mismatch",
                      "untrusted_chain",
                      "missing"
                    ]
                  }
                }
              }
            }
          ]
        },
        "error": {
          "description": "Why the check stopped, in words; null when a SQL Server answered.",
          "oneOf": [
            {
              "$ref": "../common.schema.json#/$defs/shortText"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
