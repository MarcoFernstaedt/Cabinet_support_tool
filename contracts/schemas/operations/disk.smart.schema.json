{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/disk.smart.schema.json",
  "title": "disk.smart",
  "description": "Drive health, failure prediction and reliability counters.",
  "$defs": {
    "params": {
      "$ref": "../common.schema.json#/$defs/emptyParams"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drives": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/driveHealthReport"
          }
        }
      },
      "required": [
        "drives"
      ]
    }
  }
}
