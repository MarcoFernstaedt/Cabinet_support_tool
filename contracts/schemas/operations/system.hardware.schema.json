{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/system.hardware.schema.json",
  "title": "system.hardware",
  "description": "The make and model, BIOS, processor, memory, TPM, Secure Boot, last boot time, connected displays and COM (serial) ports of the cabinet: what is needed to match drivers and spot a bad batch. Every value the cabinet cannot read is null.",
  "$defs": {
    "params": {
      "$ref": "../common.schema.json#/$defs/emptyParams"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "takenAt",
        "manufacturer",
        "model",
        "bios",
        "cpu",
        "memory",
        "tpm",
        "secureBoot",
        "lastBoot",
        "monitors",
        "ports"
      ],
      "properties": {
        "takenAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "manufacturer": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "model": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "bios": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendor",
            "version",
            "date"
          ],
          "properties": {
            "vendor": {
              "$ref": "../common.schema.json#/$defs/nullableShortText"
            },
            "version": {
              "$ref": "../common.schema.json#/$defs/nullableShortText"
            },
            "date": {
              "$ref": "../common.schema.json#/$defs/nullableTimestamp"
            }
          }
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "logicalCores"
          ],
          "properties": {
            "model": {
              "$ref": "../common.schema.json#/$defs/nullableShortText"
            },
            "logicalCores": {
              "$ref": "../common.schema.json#/$defs/nullableCount"
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "totalBytes",
            "moduleCount",
            "modules"
          ],
          "properties": {
            "totalBytes": {
              "$ref": "../common.schema.json#/$defs/nullableCount"
            },
            "moduleCount": {
              "$ref": "../common.schema.json#/$defs/nullableCount"
            },
            "modules": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "slot",
                  "capacityBytes",
                  "speedMhz"
                ],
                "properties": {
                  "slot": {
                    "$ref": "../common.schema.json#/$defs/nullableShortText"
                  },
                  "capacityBytes": {
                    "$ref": "../common.schema.json#/$defs/nullableCount"
                  },
                  "speedMhz": {
                    "$ref": "../common.schema.json#/$defs/nullableCount"
                  }
                }
              }
            }
          }
        },
        "tpm": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "present",
                "enabled",
                "version"
              ],
              "properties": {
                "present": {
                  "type": "boolean"
                },
                "enabled": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "$ref": "../common.schema.json#/$defs/nullableShortText"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "secureBoot": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "on",
                "off",
                "unsupported"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lastBoot": {
          "$ref": "../common.schema.json#/$defs/nullableTimestamp"
        },
        "monitors": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "width",
              "height"
            ],
            "properties": {
              "name": {
                "$ref": "../common.schema.json#/$defs/nullableShortText"
              },
              "width": {
                "$ref": "../common.schema.json#/$defs/nullableCount"
              },
              "height": {
                "$ref": "../common.schema.json#/$defs/nullableCount"
              }
            }
          }
        },
        "ports": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "port",
              "deviceName",
              "driverProvider",
              "driverVersion"
            ],
            "properties": {
              "port": {
                "$ref": "../common.schema.json#/$defs/shortText"
              },
              "deviceName": {
                "$ref": "../common.schema.json#/$defs/nullableShortText"
              },
              "driverProvider": {
                "$ref": "../common.schema.json#/$defs/nullableShortText"
              },
              "driverVersion": {
                "$ref": "../common.schema.json#/$defs/nullableShortText"
              }
            }
          }
        }
      }
    }
  }
}
