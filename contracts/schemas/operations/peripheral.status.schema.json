{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/peripheral.status.schema.json",
  "title": "peripheral.status",
  "description": "The fingerprint scanner, found by the hardware IDs in the agent's local configuration.",
  "$defs": {
    "params": {
      "$ref": "../common.schema.json#/$defs/emptyParams"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "name": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "errorText": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "hardwareIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/hardwareId"
          }
        },
        "driver": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "../common.schema.json#/$defs/shortText"
                },
                "version": {
                  "$ref": "../common.schema.json#/$defs/nullableShortText"
                },
                "date": {
                  "$ref": "../common.schema.json#/$defs/nullableTimestamp"
                },
                "signer": {
                  "$ref": "../common.schema.json#/$defs/nullableShortText"
                }
              },
              "required": [
                "name",
                "version",
                "date",
                "signer"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "configured",
        "connected",
        "name",
        "status",
        "errorCode",
        "errorText",
        "hardwareIds",
        "driver"
      ]
    }
  }
}
