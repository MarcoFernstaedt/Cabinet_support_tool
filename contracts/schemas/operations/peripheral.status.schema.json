{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/peripheral.status.schema.json",
  "title": "peripheral.status",
  "description": "The fingerprint scanner, found by the hardware IDs in the agent's local configuration.",
  "$defs": {
    "params": {
      "description": "The scanner's hardware IDs as set in the console (fleet default or per cabinet). When absent, the agent uses its local configuration.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardwareIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/hardwareId"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "connected": {
          "type": "boolean"
        },
        "name": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "status": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "errorText": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "hardwareIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "../common.schema.json#/$defs/hardwareId"
          }
        },
        "driver": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "../common.schema.json#/$defs/shortText"
                },
                "version": {
                  "$ref": "../common.schema.json#/$defs/nullableShortText"
                },
                "date": {
                  "$ref": "../common.schema.json#/$defs/nullableTimestamp"
                },
                "signer": {
                  "$ref": "../common.schema.json#/$defs/nullableShortText"
                }
              },
              "required": [
                "name",
                "version",
                "date",
                "signer"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "locationInfo": {
          "description": "Where Windows sees it plugged in, e.g. Port_#0002.Hub_#0003. Changes when it moves to another USB port.",
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/shortText"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check",
              "outcome",
              "summary"
            ],
            "properties": {
              "check": {
                "type": "string",
                "enum": [
                  "device_present",
                  "no_device_error",
                  "driver_installed",
                  "driver_signed",
                  "usb_power_saving",
                  "recent_reconnects",
                  "usb_controller_errors",
                  "biometric_service"
                ]
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "warn",
                  "fail",
                  "unknown"
                ]
              },
              "summary": {
                "$ref": "../common.schema.json#/$defs/shortText"
              }
            }
          }
        },
        "candidates": {
          "description": "Likely fingerprint scanners: biometric-class devices and USB devices named as fingerprint or biometric readers.",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "name",
              "class",
              "connected",
              "status",
              "hardwareIds"
            ],
            "properties": {
              "instanceId": {
                "$ref": "../common.schema.json#/$defs/deviceInstanceId"
              },
              "name": {
                "$ref": "../common.schema.json#/$defs/shortText"
              },
              "class": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/shortText"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "connected": {
                "type": "boolean"
              },
              "status": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/shortText"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hardwareIds": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "../common.schema.json#/$defs/hardwareId"
                }
              }
            }
          }
        }
      },
      "required": [
        "configured",
        "connected",
        "name",
        "status",
        "errorCode",
        "errorText",
        "hardwareIds",
        "driver",
        "locationInfo",
        "checks",
        "candidates"
      ],
      "description": "The fingerprint scanner, found by the hardware IDs in the agent's local configuration, with an automated troubleshooting checklist. When no IDs are configured, candidates lists likely scanners so support can identify the right one."
    }
  }
}
