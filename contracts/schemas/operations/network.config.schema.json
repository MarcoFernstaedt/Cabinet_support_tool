{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/network.config.schema.json",
  "title": "network.config",
  "description": "Every network adapter with addressing, gateway, DNS, DHCP lease, MTU and traffic counters, plus the routes and ARP table.",
  "$defs": {
    "params": {
      "$ref": "../common.schema.json#/$defs/emptyParams"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "interfaceIndex": {
                "$ref": "../common.schema.json#/$defs/interfaceIndex"
              },
              "name": {
                "$ref": "../common.schema.json#/$defs/shortText"
              },
              "description": {
                "$ref": "../common.schema.json#/$defs/nullableShortText"
              },
              "type": {
                "type": "string",
                "enum": [
                  "ethernet",
                  "wifi",
                  "other"
                ]
              },
              "connected": {
                "type": "boolean"
              },
              "linkSpeedBps": {
                "$ref": "../common.schema.json#/$defs/nullableCount"
              },
              "macAddress": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/macAddress"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "ipv4": {
                "$ref": "../common.schema.json#/$defs/ipv4Settings"
              },
              "ipv6Addresses": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "$ref": "../common.schema.json#/$defs/ipAddress"
                }
              },
              "dns": {
                "$ref": "../common.schema.json#/$defs/dnsSettings"
              },
              "dnsSuffix": {
                "$ref": "../common.schema.json#/$defs/nullableShortText"
              },
              "details": {
                "description": "Optional: what the adapter's DHCP lease, size limits and traffic counters say. A reading that failed is null. Newer agents also send the interface metric, admin status, driver, NetBIOS setting and the Windows network profile; each is optional and null when it could not be read.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dhcpServer",
                  "leaseObtained",
                  "leaseExpires",
                  "mtu",
                  "statistics"
                ],
                "properties": {
                  "dhcpServer": {
                    "anyOf": [
                      {
                        "$ref": "../common.schema.json#/$defs/ipv4"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "leaseObtained": {
                    "anyOf": [
                      {
                        "$ref": "../common.schema.json#/$defs/timestamp"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "leaseExpires": {
                    "anyOf": [
                      {
                        "$ref": "../common.schema.json#/$defs/timestamp"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "mtu": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 68,
                        "maximum": 65535
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "statistics": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "bytesReceived",
                          "bytesSent",
                          "receiveErrors",
                          "sendErrors",
                          "receiveDiscards",
                          "sendDiscards"
                        ],
                        "properties": {
                          "bytesReceived": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "bytesSent": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "receiveErrors": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "sendErrors": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "receiveDiscards": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "sendDiscards": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "interfaceMetric": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "adminStatus": {
                    "anyOf": [
                      {
                        "enum": [
                          "up",
                          "down",
                          "testing"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "driver": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "provider",
                          "version",
                          "date"
                        ],
                        "properties": {
                          "provider": {
                            "anyOf": [
                              {
                                "$ref": "../common.schema.json#/$defs/shortText"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "version": {
                            "anyOf": [
                              {
                                "$ref": "../common.schema.json#/$defs/shortText"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "date": {
                            "anyOf": [
                              {
                                "$ref": "../common.schema.json#/$defs/timestamp"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "netbios": {
                    "anyOf": [
                      {
                        "enum": [
                          "default",
                          "enabled",
                          "disabled"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "networkProfile": {
                    "anyOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "name",
                          "category"
                        ],
                        "properties": {
                          "name": {
                            "anyOf": [
                              {
                                "$ref": "../common.schema.json#/$defs/shortText"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "category": {
                            "enum": [
                              "public",
                              "private",
                              "domain"
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "interfaceIndex",
              "name",
              "description",
              "type",
              "connected",
              "linkSpeedBps",
              "macAddress",
              "ipv4",
              "ipv6Addresses",
              "dns",
              "dnsSuffix"
            ]
          }
        },
        "routes": {
          "description": "Optional: the cabinet's IPv4 routes other than loopback, multicast and host routes (at most 128).",
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination",
              "prefixLength",
              "nextHop",
              "metric",
              "interfaceIndex"
            ],
            "properties": {
              "destination": {
                "$ref": "../common.schema.json#/$defs/ipv4"
              },
              "prefixLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              },
              "nextHop": {
                "$ref": "../common.schema.json#/$defs/ipv4"
              },
              "metric": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "interfaceIndex": {
                "$ref": "../common.schema.json#/$defs/interfaceIndex"
              }
            }
          }
        },
        "neighbors": {
          "description": "Optional: the cabinet's ARP table, the other machines it has talked to on its networks lately (at most 64).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "interfaceIndex",
              "address",
              "macAddress",
              "state"
            ],
            "properties": {
              "interfaceIndex": {
                "$ref": "../common.schema.json#/$defs/interfaceIndex"
              },
              "address": {
                "$ref": "../common.schema.json#/$defs/ipv4"
              },
              "macAddress": {
                "anyOf": [
                  {
                    "$ref": "../common.schema.json#/$defs/macAddress"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "reachable",
                  "stale",
                  "incomplete",
                  "unreachable",
                  "other"
                ]
              }
            }
          }
        },
        "proxy": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "winHttp",
                "userProxyEnabled",
                "userProxyServer"
              ],
              "properties": {
                "winHttp": {
                  "anyOf": [
                    {
                      "$ref": "../common.schema.json#/$defs/shortText"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "userProxyEnabled": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "userProxyServer": {
                  "anyOf": [
                    {
                      "$ref": "../common.schema.json#/$defs/shortText"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "adapters"
      ]
    }
  }
}
