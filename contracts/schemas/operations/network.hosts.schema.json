{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/network.hosts.schema.json",
  "title": "network.hosts",
  "description": "The entries of the hosts file (address and host names only; comments and blank lines are left out), for finding a stale entry that sends a name to the wrong place. The file is read from its fixed Windows location; no other file can be read.",
  "$defs": {
    "params": {
      "$ref": "../common.schema.json#/$defs/emptyParams"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "takenAt",
        "entries",
        "truncated"
      ],
      "properties": {
        "takenAt": {
          "$ref": "../common.schema.json#/$defs/timestamp"
        },
        "entries": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "address",
              "names"
            ],
            "properties": {
              "address": {
                "$ref": "../common.schema.json#/$defs/ipAddress"
              },
              "names": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "$ref": "../common.schema.json#/$defs/shortText"
                }
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
