{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/operations/network.test.schema.json",
  "title": "network.test",
  "description": "A ping, DNS lookup or TCP test to one of four fixed target kinds. No free-form targets.",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "method"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "gateway",
            "dns_server",
            "sync_cabinet",
            "platform_server"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "ping",
            "dns",
            "tcp"
          ]
        },
        "dnsServerIndex": {
          "description": "Which configured DNS server (0-3) when target is dns_server.",
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "port": {
          "description": "TCP only; must also be in the agent's local allowed-port list.",
          "$ref": "../common.schema.json#/$defs/port"
        },
        "syncAddress": {
          "description": "The site's sync cabinet as set in the console. The agent accepts it only if it is a private IPv4 address on one of the cabinet's own connected networks.",
          "$ref": "../common.schema.json#/$defs/ipv4"
        },
        "syncPorts": {
          "description": "TCP ports the site's settings allow for the sync cabinet, at most 4. Used only with target sync_cabinet.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/port"
          }
        },
        "count": {
          "description": "Ping or TCP only: how many attempts to make, 1 to 20 for ping and 1 to 10 for TCP (default 1). With more than one, the output carries loss and jitter (for TCP, how many connections were made and how long each took).",
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "tcp"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "port"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "maximum": 10
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "port"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": {
                "const": "dns_server"
              }
            },
            "type": "object"
          },
          "then": {
            "required": [
              "dnsServerIndex"
            ]
          },
          "else": {
            "not": {
              "required": [
                "dnsServerIndex"
              ]
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "target": {
                "const": "sync_cabinet"
              }
            }
          },
          "then": {
            "type": "object"
          },
          "else": {
            "type": "object",
            "not": {
              "anyOf": [
                {
                  "required": [
                    "syncAddress"
                  ]
                },
                {
                  "required": [
                    "syncPorts"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "ping",
                  "tcp"
                ]
              }
            },
            "type": "object"
          },
          "else": {
            "not": {
              "required": [
                "count"
              ]
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "gateway",
            "dns_server",
            "sync_cabinet",
            "platform_server"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "ping",
            "dns",
            "tcp"
          ]
        },
        "resolvedTarget": {
          "anyOf": [
            {
              "$ref": "../common.schema.json#/$defs/ipAddress"
            },
            {
              "type": "null"
            }
          ]
        },
        "success": {
          "type": "boolean"
        },
        "latencyMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 600000
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedAddresses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "../common.schema.json#/$defs/ipAddress"
          }
        },
        "error": {
          "$ref": "../common.schema.json#/$defs/nullableShortText"
        },
        "statistics": {
          "description": "Optional: ping only, when more than one request was sent.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sent",
                "received",
                "lossPercent",
                "minMs",
                "avgMs",
                "maxMs",
                "jitterMs"
              ],
              "properties": {
                "sent": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "received": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "lossPercent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "minMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "avgMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "jitterMs": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 600000
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "target",
        "method",
        "resolvedTarget",
        "success",
        "latencyMs",
        "resolvedAddresses",
        "error"
      ]
    }
  }
}
