{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/envelopes/renew-request.schema.json",
  "title": "renew-request",
  "description": "POST /agent/v1/renew: a new CSR, authenticated by the current certificate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "csr": {
      "type": "string",
      "maxLength": 8192,
      "pattern": "^-----BEGIN CERTIFICATE REQUEST-----\\r?\\n[A-Za-z0-9+/=\\r\\n]+-----END CERTIFICATE REQUEST-----\\r?\\n?$"
    }
  },
  "required": [
    "csr"
  ]
}
