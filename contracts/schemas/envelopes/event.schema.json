{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/envelopes/event.schema.json",
  "title": "event",
  "description": "Agent-originated event: detected errors and changes (docs/spec/03-protocol.md). kind scanner comes from the fingerprint scanner watcher and carries the device and its state instead of a log record. kind service comes from the broker's service watcher; detail.fields carries service (its name), change (restarted, failing, recovered, missing, disabled) and, when known, errorCode. kind change is a system change the agent records as it happens, so it is known even if the cabinet later cannot boot: an update installed, a driver or service installed, software installed or removed, Windows starting or shutting down, a restart and who asked for it. It carries its log record like error.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "kind": {
      "type": "string",
      "enum": [
        "error",
        "firewall_changed",
        "smart_warning",
        "agent_status",
        "security",
        "scanner",
        "service",
        "change"
      ]
    },
    "occurredAt": {
      "$ref": "../common.schema.json#/$defs/timestamp"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log": {
          "$ref": "../common.schema.json#/$defs/allowedLog"
        },
        "source": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "eventId": {
          "$ref": "../common.schema.json#/$defs/eventId"
        },
        "level": {
          "$ref": "../common.schema.json#/$defs/eventLevel"
        },
        "recordId": {
          "$ref": "../common.schema.json#/$defs/recordId"
        },
        "hardwareId": {
          "$ref": "../common.schema.json#/$defs/hardwareId"
        },
        "deviceInstanceId": {
          "$ref": "../common.schema.json#/$defs/deviceInstanceId"
        }
      },
      "required": [
        "log",
        "source",
        "eventId",
        "level",
        "recordId"
      ]
    },
    "commandId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "severityHint": {
      "type": "string",
      "enum": [
        "major",
        "minor"
      ]
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message": {
          "$ref": "../common.schema.json#/$defs/longText"
        },
        "fields": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_.]{0,63}$",
            "type": "string"
          },
          "additionalProperties": {
            "allOf": [
              {
                "$ref": "../common.schema.json#/$defs/shortText"
              },
              {
                "maxLength": 1024,
                "type": "string"
              }
            ]
          }
        }
      },
      "required": []
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardwareIds",
        "state"
      ],
      "properties": {
        "hardwareIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "../common.schema.json#/$defs/hardwareId"
          }
        },
        "deviceInstanceId": {
          "$ref": "../common.schema.json#/$defs/deviceInstanceId"
        },
        "name": {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        "state": {
          "type": "string",
          "enum": [
            "disconnected",
            "device_error",
            "driver_missing",
            "recovered"
          ]
        },
        "problemCode": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    }
  },
  "required": [
    "eventId",
    "kind",
    "occurredAt",
    "severityHint",
    "detail"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "error",
              "change"
            ]
          }
        },
        "type": "object"
      },
      "then": {
        "required": [
          "source"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "firewall_changed"
          }
        },
        "type": "object"
      },
      "else": {
        "not": {
          "required": [
            "commandId"
          ]
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "scanner"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "device"
        ]
      },
      "else": {
        "type": "object",
        "not": {
          "required": [
            "device"
          ]
        }
      }
    }
  ]
}
