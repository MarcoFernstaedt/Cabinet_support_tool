{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/code-request.schema.json",
  "title": "code-request",
  "description": "An authenticator code: the second sign-in step, or confirming authenticator setup.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "description": "A 6-digit authenticator code.",
      "type": "string",
      "pattern": "^[0-9]{6}$"
    }
  },
  "required": [
    "code"
  ]
}
