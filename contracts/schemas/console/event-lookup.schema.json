{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/event-lookup.schema.json",
  "title": "event-lookup",
  "description": "From the query string: an event log entry read from a cabinet, to show which issue it maps to and how many other cabinets reported it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cabinetId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "log": {
      "$ref": "../common.schema.json#/$defs/allowedLog"
    },
    "source": {
      "$ref": "../common.schema.json#/$defs/shortText"
    },
    "eventId": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,4})$"
    }
  },
  "required": [
    "cabinetId",
    "log",
    "source",
    "eventId"
  ]
}
