{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/sync-ports.schema.json",
  "title": "sync-ports",
  "description": "Default TCP ports for testing the sync cabinet: a client's (for all its sites) or the fleet's. null removes that level's setting. A site's own ports, when set, win.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ports": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/port"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "ports",
    "stepUpToken"
  ]
}
