{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/step-up-request.schema.json",
  "title": "step-up-request",
  "description": "Asks for a step-up token for one action on one target, with a fresh authenticator code (docs/spec/02-security-model.md control 8).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "description": "A 6-digit authenticator code.",
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "enrollment.approve",
        "enrollment.reject",
        "token.create",
        "cabinet.revoke",
        "settings.scanner",
        "cabinet.scanner",
        "site.sync",
        "rule.propose",
        "rule.approve",
        "rule.reject",
        "rule.disable",
        "rule.rollback",
        "network.setIp",
        "network.setDns",
        "firewall.setProfile",
        "firewall.setRule",
        "firewall.restore",
        "package.install",
        "driver.uninstall",
        "package.upload",
        "package.approve",
        "package.retire",
        "writes.pause",
        "writes.resume",
        "user.create",
        "user.update",
        "user.delete",
        "user.password.reset",
        "user.totp.reset",
        "user.resume_writes",
        "client.create",
        "client.rename",
        "client.remove",
        "site.create",
        "site.rename",
        "site.remove",
        "cabinet.role",
        "issue_type.create",
        "issue_type.update",
        "settings.update",
        "security_alert.resolve",
        "rule.suppress",
        "rule.renew"
      ]
    },
    "target": {
      "description": "The ID the action applies to, or 'fleet'.",
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        {
          "const": "fleet"
        }
      ]
    }
  },
  "required": [
    "code",
    "action",
    "target"
  ]
}
