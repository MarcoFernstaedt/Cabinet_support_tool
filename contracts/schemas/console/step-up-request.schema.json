{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/step-up-request.schema.json",
  "title": "step-up-request",
  "description": "Asks for a step-up token for one action on one target, with a fresh authenticator code, optionally bound to the exact parameters (docs/spec/12-milestones-8-to-12.md confirmation levels).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "description": "A 6-digit authenticator code.",
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "enrollment.approve",
        "enrollment.reject",
        "token.create",
        "demo.change",
        "cabinet.revoke",
        "settings.scanner",
        "cabinet.scanner",
        "site.sync",
        "rule.propose",
        "rule.approve",
        "rule.reject",
        "rule.disable",
        "rule.rollback",
        "network.setIp",
        "network.setDns",
        "firewall.restore",
        "package.install",
        "driver.uninstall",
        "updates.uninstall",
        "system.restart",
        "process.end",
        "service.control",
        "service.setStartType",
        "package.upload",
        "package.approve",
        "package.retire",
        "writes.pause",
        "writes.resume",
        "user.create",
        "user.update",
        "user.delete",
        "user.reactivate",
        "user.password.reset",
        "user.totp.reset",
        "user.resume_writes",
        "client.create",
        "client.rename",
        "client.remove",
        "site.create",
        "site.rename",
        "site.remove",
        "cabinet.role",
        "cabinet.sync_cabinet",
        "cabinet.sync_address",
        "issue_type.create",
        "issue_type.update",
        "settings.update",
        "security_alert.resolve",
        "rule.suppress",
        "rule.renew",
        "cabinet.in_office",
        "release.add",
        "rollout.start",
        "rollout.pause",
        "rollout.resume",
        "rollout.stop",
        "client.scanner",
        "site.scanner",
        "client.sync",
        "settings.sync",
        "client.firewall_policy",
        "fleet.firewall_policy",
        "site.network_baseline",
        "runbook.approve",
        "runbook.reject",
        "runbook.retire",
        "baseline.approve",
        "baseline.reject",
        "settings.apps",
        "client.apps",
        "site.apps",
        "cabinet.apps",
        "settings.usb-policy",
        "client.usb-policy",
        "site.usb-policy",
        "cabinet.usb-policy",
        "settings.filefacts",
        "client.filefacts",
        "site.filefacts",
        "cabinet.filefacts"
      ]
    },
    "target": {
      "description": "The ID the action applies to, or 'fleet'.",
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        {
          "const": "fleet"
        }
      ]
    },
    "paramsHash": {
      "description": "SHA-256 (lowercase hex) of the canonical JSON of the exact parameters the person confirmed: keys sorted at every level, no spaces. Required for a write to a cabinet; the token then works only for those parameters.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "code",
    "action",
    "target"
  ]
}
