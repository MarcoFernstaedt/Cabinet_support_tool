{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/baseline-update.schema.json",
  "title": "baseline-update",
  "description": "Edits a draft version: its description or its content.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "content": {
      "$ref": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/baseline-content.schema.json"
    }
  }
}
