{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/cabinet-sync-cabinet.schema.json",
  "title": "cabinet-sync-cabinet",
  "description": "Assigns a satellite to a sync cabinet at its own site, or unassigns it (null), which leaves its enrollment incomplete.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "syncCabinetId": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "syncCabinetId",
    "stepUpToken"
  ]
}
