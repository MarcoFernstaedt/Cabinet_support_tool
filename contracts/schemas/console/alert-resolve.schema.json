{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/alert-resolve.schema.json",
  "title": "alert-resolve",
  "description": "Resolve a claimed alert, with an optional note on what fixed it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "note": {
      "allOf": [
