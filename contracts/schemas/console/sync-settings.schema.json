{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/sync-settings.schema.json",
  "title": "sync-settings",
  "description": "A site's sync cabinet: a private IPv4 address, and at most 4 TCP ports. ports null uses the client's default ports, else the fleet default. Each cabinet also refuses an address that is not on its own network.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "address": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/ipv4"
        },
        {
          "type": "null"
        }
      ]
    },
    "ports": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/port"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "address",
    "ports",
    "stepUpToken"
  ]
}
