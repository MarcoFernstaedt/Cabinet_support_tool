{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/permission-grant.schema.json",
  "title": "Permission grant",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "userId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "permission": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scopeKind": {
      "enum": [
        "fleet",
        "site",
        "cabinet"
      ]
    },
    "scopeId": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "stepUpToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "userId",
    "permission",
    "scopeKind",
    "scopeId",
    "stepUpToken"
  ]
}
