{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/write-pause.schema.json",
  "title": "write-pause",
  "description": "Pauses or resumes write operations fleet-wide or for one client. Reads keep working.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "paused": {
      "type": "boolean"
    },
    "reason": {
      "allOf": [
        {
          "$ref": "../common.schema.json#/$defs/shortText"
        },
        {
          "type": "string",
          "maxLength": 256
        }
      ]
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "paused",
    "stepUpToken"
  ]
}
