{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/crash-query.schema.json",
  "title": "crash-query",
  "description": "The crash investigation's window, from the query string: one cabinet (days back) or the fleet incident view (from, to and an optional client). The server limits the window to 90 days.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "days": { "type": "string", "enum": ["1", "3", "7", "14", "30", "60", "90"] },
    "from": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "to": { "$ref": "../common.schema.json#/$defs/timestamp" },
    "clientId": { "$ref": "../common.schema.json#/$defs/uuid" }
  }
}
