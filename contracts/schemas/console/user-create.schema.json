{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/user-create.schema.json",
  "title": "user-create",
  "description": "An Admin creates an account. The server makes a temporary password, shown once.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "username": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{2,64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "role": {
      "type": "string",
      "enum": [
        "tier1",
        "tier2",
        "admin"
      ]
    },
    "writeLimit": {
      "description": "Write commands allowed per hour before the user's writes pause.",
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "username",
    "name",
    "role",
    "stepUpToken"
  ]
}
