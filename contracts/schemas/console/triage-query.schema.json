{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/triage-query.schema.json",
  "title": "triage-query",
  "description": "The triage queue (query string): what needs attention first across the fleet, optionally for one client or site, looking back 7, 14 or 30 days.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "clientId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "siteId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "days": {
      "type": "string",
      "enum": [
        "7",
        "14",
        "30"
      ]
    }
  }
}
