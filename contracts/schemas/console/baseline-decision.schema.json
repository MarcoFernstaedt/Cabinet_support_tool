{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/baseline-decision.schema.json",
  "title": "baseline-decision",
  "description": "An Admin approves or rejects a proposed baseline version, with the reason in writing; confirmed with an authenticator code bound to this note.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note",
    "stepUpToken"
  ],
  "properties": {
    "note": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "stepUpToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
