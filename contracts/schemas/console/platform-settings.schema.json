{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/platform-settings.schema.json",
  "title": "platform-settings",
  "description": "An Admin changes platform settings. Only the settings sent change.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "offlineAlertDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "sessionIdleMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240
    },
    "sessionAbsoluteHours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "eventsDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 3650
        },
        "commandsDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 3650
        },
        "alertsDays": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3650
        },
        "firewallDays": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3650
        },
        "diagnosesDays": {
          "description": "Network diagnoses and their findings.",
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        },
        "bootsDays": {
          "description": "Boot records used for reboot-loop detection and crash timelines.",
          "type": "integer",
          "minimum": 30,
          "maximum": 3650
        },
        "jobsDays": {
          "description": "Fleet operation jobs and their per-cabinet results (the commands and the audit log stay).",
          "type": "integer",
          "minimum": 30,
          "maximum": 3650
        }
      }
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "agents": {
      "description": "How the agents pace themselves: the heartbeat answer carries these values (docs/spec/03-protocol.md Protocol 1.1).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "heartbeatSeconds": {
          "description": "Seconds between heartbeats.",
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        },
        "pollSeconds": {
          "description": "How long the server holds a command poll.",
          "type": "integer",
          "minimum": 15,
          "maximum": 110
        },
        "eventsPaceMs": {
          "description": "Pause between event batches while an agent catches up after an outage.",
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    }
  },
  "required": [
    "stepUpToken"
  ],
  "minProperties": 2
}
