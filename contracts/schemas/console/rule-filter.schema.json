{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/rule-filter.schema.json",
  "title": "rule-filter",
  "description": "The rules list's filters, from the query string.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "proposed",
        "live",
        "disabled",
        "expired",
        "rejected"
      ]
    },
    "issueTypeId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    }
  },
  "required": []
}
