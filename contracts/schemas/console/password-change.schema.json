{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/password-change.schema.json",
  "title": "password-change",
  "description": "Change the signed-in user's password.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "currentPassword": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "newPassword": {
      "description": "At least 12 characters.",
      "type": "string",
      "minLength": 12,
      "maxLength": 256
    }
  },
  "required": [
    "currentPassword",
    "newPassword"
  ]
}
