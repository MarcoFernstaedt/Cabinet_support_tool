{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/confirm-password.schema.json",
  "title": "confirm-password",
  "description": "Confirms a change to more than one cabinet with the person's password again (docs/spec/12-milestones-8-to-12.md). The token is bound to the action, the scope and the exact parameters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "password",
    "action",
    "target",
    "paramsHash"
  ],
  "properties": {
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "action": {
      "type": "string",
      "enum": [
        "bulk.firewall_policy"
      ]
    },
    "target": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "paramsHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
