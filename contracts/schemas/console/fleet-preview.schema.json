{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/fleet-preview.schema.json",
  "title": "fleet-preview",
  "description": "Shows what a fleet operation would do on each chosen cabinet, and which it would skip and why, without changing anything.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "cabinetIds"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "time.setZone",
        "time.sync",
        "firewall.applyPolicy",
        "network.setDns",
        "network.setIp",
        "network.renewLease"
      ]
    },
    "cabinetIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/uuid"
      }
    }
  }
}
