{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/package-rollout-start.schema.json",
  "title": "package-rollout-start",
  "description": "Starts a staged rollout of one approved software-library package (plan item 2.12, decision-log D162), on the same rules as a release's rollout: batch 1 is the one cabinet named here, the canary; the target and the batches are as in rollout-start; a batch must reach successRatePercent before the next starts, and failures above failureLimitPercent of a batch pause the rollout on their own. Each cabinet of a batch reached is sent package.install with the package's type and hash from the library, and checks the file's hash, signature and publisher itself before anything runs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packageId": {
      "description": "An approved package of the software library.",
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "pilotCabinetId": {
      "description": "The one cabinet in batch 1.",
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "successRatePercent": {
      "type": "integer",
      "minimum": 50,
      "maximum": 100
    },
    "failureLimitPercent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "target": {
      "description": "Which cabinets the rollout is for. Omitted, the whole fleet.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "fleet"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "client",
                "site"
              ]
            },
            "id": {
              "$ref": "../common.schema.json#/$defs/uuid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cabinetIds"
          ],
          "properties": {
            "kind": {
              "const": "cabinets"
            },
            "cabinetIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "uniqueItems": true,
              "items": {
                "$ref": "../common.schema.json#/$defs/uuid"
              }
            }
          }
        }
      ]
    },
    "batches": {
      "description": "The batches after the canary, in order: each a number of cabinets or a share (percent) of the cabinets left after the canary. What remains after the last is one more batch. At most eight, so a rollout has at most ten.",
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cabinets"
            ],
            "properties": {
              "cabinets": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "percent"
            ],
            "properties": {
              "percent": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        ]
      }
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "packageId",
    "pilotCabinetId",
    "successRatePercent",
    "failureLimitPercent",
    "stepUpToken"
  ]
}
