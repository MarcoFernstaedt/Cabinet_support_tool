{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/baseline-capture.schema.json",
  "title": "baseline-capture",
  "description": "Makes a draft from what a cabinet reports now. Nothing is approved by capturing: the draft is reviewed, pruned and proposed like any other.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cabinetId",
    "scope",
    "description"
  ],
  "properties": {
    "cabinetId": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "scope": {
      "$ref": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/baseline-scope.schema.json"
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500,
      "pattern": "^[^\\u0000-\\u001f\\u007f<>]+$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "$ref": "../common.schema.json#/$defs/configCategory"
      }
    }
  }
}
