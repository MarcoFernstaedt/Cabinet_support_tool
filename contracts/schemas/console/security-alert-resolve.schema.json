{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/security-alert-resolve.schema.json",
  "title": "security-alert-resolve",
  "description": "An Admin closes a security alert, saying what was found.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "note": {
      "allOf": [
        {
          "$ref": "../common.schema.json#/$defs/nonEmptyShortText"
        },
        {
          "type": "string",
          "maxLength": 256
        }
      ]
    },
    "stepUpToken": {
      "description": "A one-time step-up token bound to this exact action.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  },
  "required": [
    "note",
    "stepUpToken"
  ]
}
