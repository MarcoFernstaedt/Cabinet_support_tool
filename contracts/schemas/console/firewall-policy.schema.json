{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/firewall-policy.schema.json",
  "title": "firewall-policy",
  "description": "An Admin sets the fleet default, a client's or a site's firewall policy: each profile on or off. null for a client or site removes its own policy, so the level above applies (site \u2192 client \u2192 fleet).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy",
    "stepUpToken"
  ],
  "properties": {
    "policy": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/firewallProfilePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "stepUpToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
