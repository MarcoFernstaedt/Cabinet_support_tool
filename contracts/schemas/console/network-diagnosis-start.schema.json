{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/network-diagnosis-start.schema.json",
  "title": "network-diagnosis-start",
  "description": "Starts the network diagnosis on up to 60 chosen cabinets, or on every active cabinet of one site. Read only: it runs the same reads and tests as one cabinet's diagnosis, as the person who asked.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cabinetIds"
      ],
      "properties": {
        "cabinetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 60,
          "uniqueItems": true,
          "items": {
            "$ref": "../common.schema.json#/$defs/uuid"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "siteId"
      ],
      "properties": {
        "siteId": {
          "$ref": "../common.schema.json#/$defs/uuid"
        }
      }
    }
  ]
}
