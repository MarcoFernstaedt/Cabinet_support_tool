{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/console/audit-filter.schema.json",
  "title": "audit-filter",
  "description": "The audit log search, from the query string: by user, cabinet, action and date range, newest first.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "user": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "cabinet": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "action": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z_.]+$"
    },
    "from": {
      "description": "A date or UTC time from the query string.",
      "type": "string",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?Z)?$"
    },
    "to": {
      "description": "A date or UTC time from the query string.",
      "type": "string",
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]{1,3})?)?Z)?$"
    },
    "before": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "limit": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,2}$"
    }
  },
  "required": []
}
