{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mashura.example/cabinet-diagnostics/v1/common.schema.json",
  "title": "Common definitions",
  "description": "Shared building blocks for every envelope and operation. All times are UTC ISO 8601 with a trailing Z (docs/spec/03-protocol.md).",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "timestamp": {
      "description": "UTC time, ISO 8601, always ending in Z.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,7})?Z$"
    },
    "shortText": {
      "description": "A single line of text with no control characters.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "nonEmptyShortText": {
      "allOf": [
        {
          "$ref": "#/$defs/shortText"
        },
        {
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "longText": {
      "description": "Multi-line text such as an event message, size-capped.",
      "type": "string",
      "maxLength": 32768,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
    },
    "nullableShortText": {
      "anyOf": [
        {
          "$ref": "#/$defs/shortText"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableTimestamp": {
      "anyOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableCount": {
      "anyOf": [
        {
          "$ref": "#/$defs/count"
        },
        {
          "type": "null"
        }
      ]
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ipv4": {
      "type": "string",
      "maxLength": 15,
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}$"
    },
    "ipv4Cidr": {
      "type": "string",
      "maxLength": 18,
      "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/([0-9]|[12][0-9]|3[0-2])$"
    },
    "ipAddress": {
      "description": "IPv4 or IPv6 address as reported by Windows (read operations only).",
      "type": "string",
      "minLength": 2,
      "maxLength": 45,
      "pattern": "^[0-9A-Fa-f:.%]+$"
    },
    "prefixLength": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "interfaceIndex": {
      "description": "Windows network interface index.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "macAddress": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{2}([-:][0-9A-Fa-f]{2}){5}$"
    },
    "sha256": {
      "description": "Lower-case hex SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agentVersion": {
      "description": "Semantic version of the agent.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})(-[0-9A-Za-z.-]{1,32})?$"
    },
    "hostname": {
      "description": "Windows computer name or DNS host name.",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,62})(\\.[A-Za-z0-9]([A-Za-z0-9-]{0,62}))*$"
    },
    "hardwareId": {
      "description": "Plug and Play hardware ID such as USB\\VID_1234&PID_5678.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9\\\\&_.#{}=,+ -]+$"
    },
    "deviceInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[A-Za-z0-9\\\\&_.#{}=,+ -]+$"
    },
    "eventLevel": {
      "type": "string",
      "enum": [
        "critical",
        "error",
        "warning",
        "information",
        "verbose"
      ]
    },
    "allowedLog": {
      "description": "The event logs the agent may read, compiled in (docs/spec/04-agent-spec.md, widened in milestone 1 to every channel useful for diagnosis; see docs/spec/09-open-decisions.md). Logs that record sign-ins, credentials, remote sessions, script or command text, or printed document names are never readable: Security, PowerShell, Sysmon, Winlogon, User Profile, TerminalServices, NTLM, Kerberos, CAPI2, AAD and PrintService/Operational are deliberately absent.",
      "type": "string",
      "enum": [
        "System",
        "Application",
        "Setup",
        "HardwareEvents",
        "Microsoft-Windows-Kernel-PnP/Configuration",
        "Microsoft-Windows-Kernel-PnP/Driver Watchdog",
        "Microsoft-Windows-DriverFrameworks-UserMode/Operational",
        "Microsoft-Windows-UserPnp/DeviceInstall",
        "Microsoft-Windows-DeviceSetupManager/Admin",
        "Microsoft-Windows-DeviceSetupManager/Operational",
        "Microsoft-Windows-Biometrics/Operational",
        "Microsoft-Windows-CodeIntegrity/Operational",
        "Microsoft-Windows-Kernel-WHEA/Errors",
        "Microsoft-Windows-Kernel-WHEA/Operational",
        "Microsoft-Windows-Kernel-Power/Thermal-Operational",
        "Microsoft-Windows-Kernel-Boot/Operational",
        "Microsoft-Windows-Kernel-IO/Operational",
        "Microsoft-Windows-Diagnostics-Performance/Operational",
        "Microsoft-Windows-Resource-Exhaustion-Detector/Operational",
        "Microsoft-Windows-Storage-Storport/Operational",
        "Microsoft-Windows-Storage-Storport/Health",
        "Microsoft-Windows-Storage-ClassPnP/Operational",
        "Microsoft-Windows-StorageSpaces-Driver/Operational",
        "Microsoft-Windows-Ntfs/Operational",
        "Microsoft-Windows-Partition/Diagnostic",
        "Microsoft-Windows-NetworkProfile/Operational",
        "Microsoft-Windows-NCSI/Operational",
        "Microsoft-Windows-TCPIP/Operational",
        "Microsoft-Windows-Dhcp-Client/Admin",
        "Microsoft-Windows-Dhcp-Client/Operational",
        "Microsoft-Windows-DNS-Client/Operational",
        "Microsoft-Windows-WLAN-AutoConfig/Operational",
        "Microsoft-Windows-SMBClient/Connectivity",
        "Microsoft-Windows-SMBClient/Operational",
        "Microsoft-Windows-Windows Firewall With Advanced Security/Firewall",
        "Microsoft-Windows-Time-Service/Operational",
        "Microsoft-Windows-WindowsUpdateClient/Operational",
        "Microsoft-Windows-Bits-Client/Operational",
        "Microsoft-Windows-TaskScheduler/Operational",
        "Microsoft-Windows-PrintService/Admin",
        "Microsoft-Windows-Windows Defender/Operational",
        "Microsoft-Windows-GroupPolicy/Operational"
      ]
    },
    "eventId": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "recordId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cabinetRole": {
      "type": "string",
      "enum": [
        "sync",
        "satellite",
        "standalone"
      ]
    },
    "operationName": {
      "description": "Every operation in the agent catalog (contracts/schemas/operations/catalog.json).",
      "type": "string",
      "enum": [
        "system.info",
        "eventlog.channels",
        "eventlog.query",
        "eventlog.get",
        "devices.list",
        "drivers.list",
        "peripheral.status",
        "updates.status",
        "disk.smart",
        "files.list",
        "network.config",
        "network.test",
        "network.trace",
        "firewall.state",
        "network.setIp",
        "network.setDns",
        "firewall.setProfile",
        "firewall.applyPolicy",
        "firewall.setRule",
        "firewall.restore",
        "package.install",
        "driver.uninstall",
        "services.list",
        "processes.list",
        "service.control",
        "time.status",
        "time.setZone",
        "time.sync",
        "network.renewLease"
      ]
    },
    "rejectionCode": {
      "description": "Why the agent refused a command without running it (docs/spec/03-protocol.md).",
      "type": "string",
      "enum": [
        "unknown_operation",
        "invalid_params",
        "expired",
        "replayed",
        "wrong_cabinet",
        "read_only_mode",
        "rate_limited",
        "hash_mismatch",
        "signature_invalid",
        "publisher_not_trusted",
        "verification_failed"
      ]
    },
    "failureCode": {
      "description": "Why a command that started did not succeed. Provisional set, see docs/spec/09-open-decisions.md.",
      "type": "string",
      "enum": [
        "execution_failed",
        "timeout",
        "not_found",
        "unavailable",
        "safety_net_rollback"
      ]
    },
    "firewallProfile": {
      "type": "string",
      "enum": [
        "domain",
        "private",
        "public"
      ]
    },
    "firewallAction": {
      "type": "string",
      "enum": [
        "allow",
        "block"
      ]
    },
    "firewallDirection": {
      "type": "string",
      "enum": [
        "in",
        "out"
      ]
    },
    "firewallProtocol": {
      "type": "string",
      "enum": [
        "any",
        "tcp",
        "udp",
        "icmpv4"
      ]
    },
    "portRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/port"
        },
        "to": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "windowsProgramPath": {
      "description": "Absolute local path to a program file. No relative segments, UNC, device or wildcard paths.",
      "type": "string",
      "minLength": 4,
      "maxLength": 260,
      "pattern": "^[A-Za-z]:\\\\(?!.*(^|\\\\)\\.{1,2}(\\\\|$))[^\\u0000-\\u001f\\u007f<>:\"/|?*]+\\.[Ee][Xx][Ee]$"
    },
    "firewallRule": {
      "description": "One Windows firewall rule, as structured fields only. No free-text rule strings.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "action",
        "protocol",
        "enabled",
        "profiles"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()-]*$"
        },
        "direction": {
          "$ref": "#/$defs/firewallDirection"
        },
        "action": {
          "$ref": "#/$defs/firewallAction"
        },
        "protocol": {
          "$ref": "#/$defs/firewallProtocol"
        },
        "localPorts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/portRange"
          }
        },
        "remotePorts": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/portRange"
          }
        },
        "localAddresses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ipv4"
              },
              {
                "$ref": "#/$defs/ipv4Cidr"
              }
            ]
          }
        },
        "remoteAddresses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ipv4"
              },
              {
                "$ref": "#/$defs/ipv4Cidr"
              }
            ]
          }
        },
        "programPath": {
          "$ref": "#/$defs/windowsProgramPath"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/firewallProfile"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "reportedFirewallRule": {
      "description": "A firewall rule as read back from Windows. Wider than firewallRule because existing rules may use features the platform never writes.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "direction",
        "action",
        "enabled",
        "createdByPlatform"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/shortText"
        },
        "displayGroup": {
          "$ref": "#/$defs/nullableShortText"
        },
        "direction": {
          "$ref": "#/$defs/firewallDirection"
        },
        "action": {
          "$ref": "#/$defs/firewallAction"
        },
        "protocol": {
          "$ref": "#/$defs/shortText"
        },
        "localPorts": {
          "$ref": "#/$defs/shortText"
        },
        "remotePorts": {
          "$ref": "#/$defs/shortText"
        },
        "localAddresses": {
          "$ref": "#/$defs/shortText"
        },
        "remoteAddresses": {
          "$ref": "#/$defs/shortText"
        },
        "programPath": {
          "$ref": "#/$defs/nullableShortText"
        },
        "profiles": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/firewallProfile"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "createdByPlatform": {
          "description": "True for rules whose name starts with MashuraDiag.",
          "type": "boolean"
        }
      }
    },
    "firewallProfileState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "enabled",
        "defaultInbound",
        "defaultOutbound",
        "reenableAt"
      ],
      "properties": {
        "profile": {
          "$ref": "#/$defs/firewallProfile"
        },
        "enabled": {
          "type": "boolean"
        },
        "defaultInbound": {
          "$ref": "#/$defs/firewallAction"
        },
        "defaultOutbound": {
          "$ref": "#/$defs/firewallAction"
        },
        "reenableAt": {
          "description": "When a temporarily disabled profile turns itself back on; null when no timer is running.",
          "$ref": "#/$defs/nullableTimestamp"
        }
      }
    },
    "ipv4Settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dhcp",
        "addresses",
        "gateways"
      ],
      "properties": {
        "dhcp": {
          "type": "boolean"
        },
        "addresses": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "address",
              "prefixLength"
            ],
            "properties": {
              "address": {
                "$ref": "#/$defs/ipv4"
              },
              "prefixLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              }
            }
          }
        },
        "gateways": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        }
      }
    },
    "dnsSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic",
        "servers"
      ],
      "properties": {
        "automatic": {
          "type": "boolean"
        },
        "servers": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        }
      }
    },
    "emptyParams": {
      "description": "Operations that take no parameters accept only an empty object.",
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "symptomMatch": {
      "description": "What a symptom rule matches: structured fields only, all of which must agree (docs/spec/05-server-spec.md). The phrase is a plain case-insensitive substring of the message; there are no regular expressions.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "error",
            "firewall_changed",
            "smart_warning",
            "agent_status",
            "security",
            "scanner"
          ]
        },
        "log": {
          "$ref": "#/$defs/allowedLog"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyShortText"
        },
        "eventId": {
          "$ref": "#/$defs/eventId"
        },
        "level": {
          "$ref": "#/$defs/eventLevel"
        },
        "hardwareId": {
          "$ref": "#/$defs/hardwareId"
        },
        "phrase": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*[^\\u0000-\\u001f\\u007f ][^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "upgradeCheck": {
      "description": "Which step of an agent upgrade failed (docs/spec/07-upgrade-channel.md), in the order they run: download; manifest_signature (against the compiled-in key); manifest (does not match its contract or is not for this product); package_hash; version (not newer than the running one, or the running one is older than the release's minimum); authenticode (a binary is not signed by the agent's publisher); install (the files could not be put in place); check_in (the new version did not reach the server within 5 minutes).",
      "type": "string",
      "enum": [
        "download",
        "manifest_signature",
        "manifest",
        "package_hash",
        "version",
        "authenticode",
        "install",
        "check_in"
      ]
    },
    "firewallProfileSwitches": {
      "description": "Each firewall profile's on/off state: what the heartbeat reports and what a client's firewall policy asks for.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "private",
        "public"
      ],
      "properties": {
        "domain": {
          "type": "boolean"
        },
        "private": {
          "type": "boolean"
        },
        "public": {
          "type": "boolean"
        }
      }
    },
    "serviceName": {
      "description": "A Windows service's key name (not its display name). Letters, digits, _ . $ - and inner spaces; SQL Server's MSSQL$NAME form included.",
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_.$-](?:[A-Za-z0-9_.$ -]{0,78}[A-Za-z0-9_.$-])?$"
    },
    "serviceState": {
      "type": "string",
      "enum": [
        "running",
        "stopped",
        "start_pending",
        "stop_pending",
        "paused",
        "pause_pending",
        "continue_pending",
        "unknown"
      ]
    },
    "serviceStartType": {
      "type": "string",
      "enum": [
        "automatic",
        "automatic_delayed",
        "manual",
        "disabled",
        "boot",
        "system",
        "unknown"
      ]
    },
    "watchedServiceStatus": {
      "description": "One watched service as the broker's watcher sees it (docs/spec/12-milestones-8-to-12.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "serviceState",
        "restartsToday",
        "consecutiveFailures",
        "lastRestartAt",
        "lastError",
        "checkedAt"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/serviceName"
        },
        "state": {
          "description": "running: as it should be; restarted: started again by the watcher in the last 10 minutes; failing: 3 restarts in a row failed; missing: no such service; disabled: its start type is Disabled; refused: the agent never starts it (its own services, remote access); waiting: not checked yet.",
          "type": "string",
          "enum": [
            "running",
            "restarted",
            "failing",
            "missing",
            "disabled",
            "refused",
            "waiting"
          ]
        },
        "serviceState": {
          "anyOf": [
            {
              "$ref": "#/$defs/serviceState"
            },
            {
              "type": "null"
            }
          ]
        },
        "restartsToday": {
          "$ref": "#/$defs/count"
        },
        "consecutiveFailures": {
          "$ref": "#/$defs/count"
        },
        "lastRestartAt": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "lastError": {
          "description": "The last Windows error code a start attempt returned, if any.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "checkedAt": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      }
    },
    "watchedServiceNames": {
      "description": "Services that must always be running; the broker starts them again when they stop.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/serviceName"
      }
    },
    "serviceRecoveryAction": {
      "type": "string",
      "enum": [
        "none",
        "restart",
        "reboot",
        "run_program"
      ]
    },
    "timeZoneId": {
      "description": "A Windows time zone the platform may set (docs/spec/13-roadmap.md module 21): the United States zones, with Arizona (US Mountain Standard Time, no daylight saving) separate from Mountain.",
      "type": "string",
      "enum": [
        "Eastern Standard Time",
        "Central Standard Time",
        "Mountain Standard Time",
        "US Mountain Standard Time",
        "Pacific Standard Time",
        "Alaskan Standard Time",
        "Hawaiian Standard Time"
      ]
    },
    "reportedTimeZoneId": {
      "description": "A Windows time zone ID as a cabinet reports it; any zone can be reported, only timeZoneId zones can be set.",
      "type": "string",
      "pattern": "^[A-Za-z0-9 ()+.,'-]{1,64}$"
    },
    "networkBaseline": {
      "description": "What a site's network should look like (set by a Tier 2 or Admin): whether cabinets take their address from DHCP or have fixed ones, the subnet's size, the gateway, and the DNS servers. The diagnosis compares each cabinet with it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressing",
        "prefixLength",
        "gateway",
        "dnsServers"
      ],
      "properties": {
        "addressing": {
          "type": "string",
          "enum": [
            "dhcp",
            "static"
          ]
        },
        "prefixLength": {
          "type": "integer",
          "minimum": 8,
          "maximum": 30
        },
        "gateway": {
          "$ref": "#/$defs/ipv4"
        },
        "dnsServers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        }
      }
    }
  }
}
